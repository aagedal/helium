-// Delegated method. Error handler for the Sparkle messages.
+// Retry availability failures once through the independently hosted mirror.
+// Validation, signature, extraction and installation failures must remain errors.
+- (BOOL)canRetryOnMirror:(NSError*)error {
+  return !usingMirror_ && [error.domain isEqualToString:SUSparkleErrorDomain] &&
+         (error.code == SUAppcastError || error.code == SUAppcastParseError ||
+          error.code == SUDownloadError) && [self shouldAccessUpdateService] &&
+         helium::GetBrowserUpdateURL(*profile_->GetPrefs(), true) !=
+             helium::GetDummyURL();
+}
+
 - (void)updater:(SPUUpdater*)updater didAbortWithError:(NSError*)error {
-  if (error.code == SUNoUpdateError) {
-    // Handled by notifications
+  if ([error.domain isEqualToString:SUSparkleErrorDomain] &&
+      error.code == SUNoUpdateError) {
+    return;
+  }
+  if ([self canRetryOnMirror:error]) {
     return;
   }
   [self updateStatus:VersionUpdater::FAILED
         error_string:[error.localizedDescription copy]];
+}
+
+- (void)updater:(SPUUpdater*)updater
+    didFinishUpdateCycleForUpdateCheck:(SPUUpdateCheck)updateCheck
+                                error:(NSError*)error {
+  if (error && [self canRetryOnMirror:error]) {
+    usingMirror_ = YES;
+    [self updateStatus:VersionUpdater::CHECKING error_string:nil];
+    // Start here while Sparkle is idle. Queuing this lets its scheduler reserve
+    // another session first, causing checkForUpdatesInBackground to be ignored.
+    [updater checkForUpdatesInBackground];
+  } else {
+    // The next independent check always tries GitHub first.
+    usingMirror_ = NO;
+  }
 }
 
