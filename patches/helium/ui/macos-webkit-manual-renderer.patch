+bool IsWebKitStreamingTabsEnabled() {
+  if (@available(macOS 14.0, *)) {
+    return base::CommandLine::ForCurrentProcess()->HasSwitch(kStreamingTabsSwitch);
+  }
+  return false;
+}
+
+bool CanToggleWebKitStreamingTab(content::WebContents* contents,
+                                bool profile_allowed) {
+  if (!IsWebKitStreamingTabsEnabled() || !profile_allowed || !contents ||
+      contents->GetBrowserContext()->IsOffTheRecord())
+    return false;
+  return GetWebKitStreamingTabView(contents) ||
+         IsWebKitPageURL(contents->GetLastCommittedURL());
+}
+
+void ToggleWebKitStreamingTab(content::WebContents* contents,
+                             bool profile_allowed) {
+  if (!CanToggleWebKitStreamingTab(contents, profile_allowed))
+    return;
+  auto* tab = GetStreamingTab(contents);
+  if (!tab) {
+    auto owned = std::make_unique<StreamingTab>(contents);
+    tab = owned.get();
+    contents->SetUserData(kStreamingTabKey, std::move(owned));
+  }
+  tab->Toggle();
+}
