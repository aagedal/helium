+IN_PROC_BROWSER_TEST_F(PinnedTabCodecBrowserTest,
+                       SplitAndPaneSettingsRoundTrip) {
+  auto* model = browser()->tab_strip_model();
+  model->CreateOrUpdatePaneSplit(0, 6, split_tabs::SplitTabVisualData());
+  const auto id = *model->GetTabAtIndex(0)->GetSplit();
+  auto visual = *model->GetSplitData(id)->visual_data();
+  visual.set_split_layout(split_tabs::SplitTabLayout::kStacked);
+  visual.set_arrangement(split_tabs::SplitTabArrangement::kLeadingStacked);
+  visual.set_split_ratio(0.37);
+  visual.set_pane_weights({1, 2, 3, 4, 5, 6});
+  model->CreateOrUpdatePaneSplit(0, 6, visual);
+  model->SetTabPinned(0, true);
+  for (int i = 0; i < 6; ++i) {
+    auto* settings =
+        tabs::PaneSettings::GetOrCreate(model->GetWebContentsAt(i));
+    settings->SetRefreshSeconds(i * 15);
+  }
+  PinnedTabCodec::WritePinnedTabs(browser()->GetProfile());
+  auto saved = PinnedTabCodec::ReadPinnedTabs(browser()->GetProfile());
+  ASSERT_EQ(6u, saved.size());
+  saved[1].pane_extra_data["helium.mobile_preview"] = "2";
+  // Exercise the StartupTabs overload too, preserving all metadata.
+  PinnedTabCodec::WritePinnedTabs(browser()->GetProfile(), saved);
+  saved = PinnedTabCodec::ReadPinnedTabs(browser()->GetProfile());
+  ASSERT_EQ(6u, saved.size());
+  for (int i = 0; i < 6; ++i) {
+    EXPECT_EQ(saved[i].pinned_split_id, saved[0].pinned_split_id);
+    ASSERT_TRUE(saved[i].pinned_split_visual_data);
+    EXPECT_EQ(saved[i].pinned_split_visual_data->split_ratio(), 0.37);
+    EXPECT_EQ(saved[i].pinned_split_visual_data->arrangement(),
+              split_tabs::SplitTabArrangement::kLeadingStacked);
+    EXPECT_EQ(saved[i].pinned_split_visual_data->pane_weights(),
+              visual.pane_weights());
+    EXPECT_EQ(saved[i].pane_extra_data["helium.auto_refresh_seconds"],
+              std::to_string(i * 15));
+  }
+  EXPECT_EQ(saved[1].pane_extra_data["helium.mobile_preview"], "2");
+
+  // Exercise the actual non-session startup path, including deferred panes.
+  saved[1].url = GURL("https://example.test/mobile");
+  auto* restored_browser = CreateBrowser(browser()->GetProfile());
+  base::CommandLine command_line(base::CommandLine::NO_PROGRAM);
+  StartupBrowserCreatorImpl creator(base::FilePath(), command_line,
+                                    chrome::startup::IsFirstRun::kNo);
+  creator.OpenTabsInBrowser(restored_browser,
+                            chrome::startup::IsProcessStartup::kNo, saved);
+  auto* restored_model = restored_browser->tab_strip_model();
+  const auto restored_id = restored_model->GetTabAtIndex(0)->GetSplit();
+  ASSERT_TRUE(restored_id);
+  auto* data = restored_model->GetSplitData(*restored_id);
+  EXPECT_EQ(data->ListTabs().size(), 6u);
+  EXPECT_EQ(data->visual_data()->split_ratio(), visual.split_ratio());
+  EXPECT_EQ(data->visual_data()->split_layout(), visual.split_layout());
+  EXPECT_EQ(data->visual_data()->arrangement(), visual.arrangement());
+  EXPECT_EQ(data->visual_data()->pane_weights(), visual.pane_weights());
+  for (int i = 0; i < 6; ++i) {
+    EXPECT_TRUE(restored_model->GetTabAtIndex(i)->IsPinned());
+    EXPECT_EQ(restored_model->GetTabAtIndex(i)->GetSplit(), restored_id);
+    auto* restored_settings = tabs::PaneSettings::FromWebContents(
+        restored_model->GetWebContentsAt(i));
+    ASSERT_TRUE(restored_settings);
+    EXPECT_EQ(restored_settings->refresh_seconds(), i * 15);
+    EXPECT_EQ(restored_settings->mobile_enabled(), i == 1);
+    EXPECT_EQ(restored_settings->mobile_full_height(), i == 1);
+  }
+}
