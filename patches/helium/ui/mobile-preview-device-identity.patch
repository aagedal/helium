+IN_PROC_BROWSER_TEST_F(TabMenuModelBrowserTest, MobilePreviewDeviceIdentity) {
+  ASSERT_TRUE(embedded_test_server()->Start());
+  const GURL url = embedded_test_server()->GetURL(
+      "/echoheader?User-Agent&Sec-CH-UA-Mobile&Sec-CH-UA-Platform");
+  ASSERT_TRUE(ui_test_utils::NavigateToURL(browser(), url));
+  auto* desktop = browser()->tab_strip_model()->GetActiveWebContents();
+  chrome::NewTab(browser(), NewTabTypes::kNoUserAction);
+  ASSERT_TRUE(ui_test_utils::NavigateToURL(browser(), url));
+  auto* mobile = browser()->tab_strip_model()->GetActiveWebContents();
+  auto* settings = tabs::PaneSettings::GetOrCreate(mobile);
+  const auto desktop_ua =
+      content::EvalJs(desktop, "navigator.userAgent").ExtractString();
+  {
+    content::TestNavigationObserver reload(mobile);
+    settings->SetMobileEnabled(true);
+    reload.Wait();
+  }
+  EXPECT_EQ(true, content::EvalJs(mobile,
+      "navigator.userAgent.includes('Android') && "
+      "navigator.userAgent.includes(' Mobile ')"));
+  EXPECT_EQ(true, content::EvalJs(mobile, "navigator.userAgentData.mobile"));
+  EXPECT_EQ("Android", content::EvalJs(mobile, "navigator.userAgentData.platform"));
+  EXPECT_EQ("Linux armv81", content::EvalJs(mobile, "navigator.platform"));
+  EXPECT_EQ(true, content::EvalJs(mobile,
+      "document.body.innerText.includes(' Mobile ') && "
+      "document.body.innerText.includes('?1') && "
+      "document.body.innerText.includes('Android')"));
+  EXPECT_EQ(desktop_ua, content::EvalJs(desktop, "navigator.userAgent"));
+  EXPECT_EQ(false, content::EvalJs(desktop, "navigator.userAgentData.mobile"));
+  // Changing between mobile heights must not reload the document.
+  EXPECT_EQ(true, content::EvalJs(mobile, "window.identitySentinel = true"));
+  settings->SetMobileEnabled(true, true);
+  EXPECT_EQ(true, content::EvalJs(mobile, "window.identitySentinel"));
+  {
+    content::TestNavigationObserver reload(mobile);
+    settings->SetMobileEnabled(false);
+    reload.Wait();
+  }
+  EXPECT_EQ(desktop_ua, content::EvalJs(mobile, "navigator.userAgent"));
+  EXPECT_EQ(false, content::EvalJs(mobile, "navigator.userAgentData.mobile"));
+  EXPECT_EQ(true, content::EvalJs(mobile,
+      "!document.body.innerText.includes(' Mobile ') && "
+      "document.body.innerText.includes('?0')"));
+}
