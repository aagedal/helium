+IN_PROC_BROWSER_TEST_F(TabMenuModelBrowserTest, SplitMenuKeepsTabIdentity) {
+  auto* model = browser()->tab_strip_model();
+  model->CreateOrUpdatePaneSplit(0, 3, split_tabs::SplitTabVisualData());
+  auto* target = model->GetWebContentsAt(1);
+  SplitTabMenuModel menu(model, SplitTabMenuModel::MenuSource::kMiniToolbar, 1);
+  model->delegate()->AddTabAt(GURL(), 0, false, std::nullopt, false);
+  ASSERT_EQ(2, model->GetIndexOfWebContents(target));
+  const int close_command =
+      ExistingBaseSubMenuModel::kMinSplitTabMenuModelCommandId +
+      static_cast<int>(SplitTabMenuModel::CommandId::kCloseSpecifiedTab);
+  ASSERT_TRUE(menu.IsCommandIdEnabled(close_command));
+  menu.ExecuteCommand(close_command, 0);
+  EXPECT_EQ(TabStripModel::kNoTab, model->GetIndexOfWebContents(target));
+  EXPECT_FALSE(menu.IsCommandIdEnabled(close_command));
+}
