+// Regression: accessibility used to hit NOTREACHED for pane indices 2 and 3.
+IN_PROC_BROWSER_TEST_F(TabMenuModelBrowserTest, FourPaneSplitAccessibleLabels) {
+  auto* model = browser()->tab_strip_model();
+  for (int i = 0; i < 3; ++i) {
+    chrome::NewTab(browser());
+  }
+  for (auto layout : {split_tabs::SplitTabLayout::kSideBySide,
+                      split_tabs::SplitTabLayout::kStacked}) {
+    const auto split = model->AddToNewSplit(
+        {0, 1, 2, 3}, split_tabs::SplitTabVisualData(layout),
+        split_tabs::SplitTabCreatedSource::kTabContextMenu);
+    for (int i = 0; i < 4; ++i) {
+      EXPECT_FALSE(tabs::GetAccessibleTabLabel(model->GetTabAtIndex(i), true)
+                       .empty());
+    }
+    model->RemoveSplit(split);
+  }
+}
+
+IN_PROC_BROWSER_TEST_F(TabMenuModelBrowserTest, CreateAndExpandFourPaneSplit) {
+  auto* model = browser()->tab_strip_model();
+  auto* original = model->GetActiveTab();
+  model->ExecuteContextMenuCommand(model->active_index(),
+                                  TabStripModel::CommandCreateFourPaneSplit);
+  EXPECT_EQ(original, model->GetActiveTab());
+  auto split = original->GetSplit().value();
+  EXPECT_EQ(4u, model->GetSplitData(split)->ListTabs().size());
+  EXPECT_FALSE(model->IsContextMenuCommandEnabled(
+      model->active_index(), TabStripModel::CommandCreateFourPaneSplit));
+  model->RemoveSplit(split);
+  split = model->AddToNewSplit(
+      {0, 1}, split_tabs::SplitTabVisualData(
+                  split_tabs::SplitTabLayout::kStacked, 0.65),
+      split_tabs::SplitTabCreatedSource::kTabContextMenu);
+  auto* second = model->GetTabAtIndex(1);
+  const int previous_count = model->count();
+  model->ExecuteContextMenuCommand(1, TabStripModel::CommandCreateFourPaneSplit);
+  EXPECT_EQ(previous_count + 2, model->count());
+  EXPECT_EQ(second, model->GetActiveTab());
+  split = second->GetSplit().value();
+  const auto* data = model->GetSplitData(split);
+  EXPECT_EQ(4u, data->ListTabs().size());
+  EXPECT_EQ(original, data->ListTabs()[0]);
+  EXPECT_EQ(second, data->ListTabs()[1]);
+  EXPECT_EQ(split_tabs::SplitTabLayout::kStacked,
+            data->visual_data()->split_layout());
+  EXPECT_DOUBLE_EQ(0.65, data->visual_data()->split_ratio());
+}
