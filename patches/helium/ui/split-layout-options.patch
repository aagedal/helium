+void TabStripModel::CreateOrUpdatePaneSplit(
+    int context_index,
+    size_t pane_count,
+    split_tabs::SplitTabVisualData visual_data) {
+  if (!ContainsIndex(context_index) || pane_count < 2 || pane_count > 4) {
+    return;
+  }
+  tabs::TabInterface* context_tab = GetTabAtIndex(context_index);
+  std::vector<tabs::TabInterface*> panes = {context_tab};
+  if (const auto split = context_tab->GetSplit()) {
+    auto* data = GetSplitData(*split);
+    panes = data->ListTabs();
+    if (panes.size() > pane_count) {
+      return;
+    }
+    if (panes.size() == pane_count) {
+      ReentrancyCheck reentrancy_check(&reentrancy_guard_);
+      const auto old_data = *data->visual_data();
+      if (old_data != visual_data) {
+        *data->visual_data() = visual_data;
+        NotifySplitTabVisualsChanged(
+            *split, old_data, visual_data,
+            SplitTabChange::SplitVisualChangeReason::kLayoutUpdated);
+      }
+      return;
+    }
+  }
+  const auto group = context_tab->GetGroup();
+  const bool pinned = context_tab->IsPinned();
+  while (panes.size() < pane_count) {
+    const int insertion_index = GetIndexOfTab(panes.back()) + 1;
+    const int previous_count = count();
+    delegate_->AddTabAt(GURL(), insertion_index, false, group, pinned);
+    if (count() != previous_count + 1) {
+      return;
+    }
+    panes.push_back(GetTabAtIndex(insertion_index));
+  }
+  if (const auto split = context_tab->GetSplit()) {
+    RemoveSplit(*split);
+  }
+  std::vector<int> indices;
+  for (auto* pane : panes) {
+    indices.push_back(GetIndexOfTab(pane));
+  }
+  ActivateTabAt(GetIndexOfTab(context_tab));
+  AddToNewSplit(indices, visual_data,
+                split_tabs::SplitTabCreatedSource::kTabContextMenu);
+}
