+// Partitioning within each side of the main, resizable divider.
+// Values are stored in session commands; do not renumber.
+enum class SplitTabArrangement {
+  kGrid = 0,
+  kLinear = 1,
+  kLeadingSingle = 2,
+  kTrailingSingle = 3,
+};
+
+inline size_t FirstSplitPaneCount(size_t count, SplitTabArrangement arrangement) {
+  if (arrangement == SplitTabArrangement::kLeadingSingle) {
+    return 1;
+  }
+  if (arrangement == SplitTabArrangement::kTrailingSingle) {
+    return count - 1;
+  }
+  return (count + 1) / 2;
+}
+
+inline std::array<GridPaneBounds, 4> CalculateSplitPaneBounds(
+    GridPaneBounds start,
+    GridPaneBounds end,
+    size_t count,
+    SplitTabLayout layout,
+    SplitTabArrangement arrangement) {
+  std::array<GridPaneBounds, 4> panes{};
+  if (count < 2 || count > panes.size()) {
+    return panes;
+  }
+  const size_t first_count = FirstSplitPaneCount(count, arrangement);
+  const bool vertical = (layout == SplitTabLayout::kSideBySide) !=
+                        (arrangement == SplitTabArrangement::kLinear);
+  const auto subdivide = [&](GridPaneBounds bounds, size_t first, size_t size) {
+    const int extent = vertical ? bounds.height : bounds.width;
+    for (size_t i = 0; i < size; ++i) {
+      auto pane = bounds;
+      const int begin = extent * static_cast<int>(i) / static_cast<int>(size);
+      const int limit = extent * static_cast<int>(i + 1) / static_cast<int>(size);
+      if (vertical) {
+        pane.y += begin;
+        pane.height = limit - begin;
+      } else {
+        pane.x += begin;
+        pane.width = limit - begin;
+      }
+      panes[first + i] = pane;
+    }
+  };
+  subdivide(start, 0, first_count);
+  subdivide(end, first_count, count - first_count);
+  return panes;
+}
