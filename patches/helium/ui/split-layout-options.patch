+class PaneLayoutMenuModel : public ui::SimpleMenuModel,
+                            public ui::SimpleMenuModel::Delegate {
+ public:
+  PaneLayoutMenuModel(TabStripModel* model, tabs::TabInterface* tab)
+      : ui::SimpleMenuModel(this), model_(model), tab_(tab->GetWeakPtr()) {
+    for (size_t i = 0; i < std::size(kPaneLayouts); ++i) {
+      if (i == 5 || i == 9) {
+        AddSeparator(ui::MenuSeparatorType::NORMAL_SEPARATOR);
+      }
+      AddCheckItem(kFirstPaneLayoutCommand + i,
+                   l10n_util::GetStringUTF16(kPaneLayouts[i].label));
+    }
+  }
+
+  bool IsCommandIdEnabled(int command) const override {
+    const int option = command - kFirstPaneLayoutCommand;
+    if (!tab_ || model_->GetIndexOfTab(tab_.get()) == TabStripModel::kNoTab ||
+        option < 0 || static_cast<size_t>(option) >= std::size(kPaneLayouts)) {
+      return false;
+    }
+    return !tab_->GetSplit() ||
+           model_->GetSplitData(*tab_->GetSplit())->ListTabs().size() <=
+               kPaneLayouts[option].count;
+  }
+
+  bool IsCommandIdChecked(int command) const override {
+    if (!IsCommandIdEnabled(command) || !tab_->GetSplit()) {
+      return false;
+    }
+    const auto& option = kPaneLayouts[command - kFirstPaneLayoutCommand];
+    const auto* data = model_->GetSplitData(*tab_->GetSplit());
+    return data->ListTabs().size() == option.count &&
+           data->visual_data()->split_layout() == option.orientation &&
+           data->visual_data()->arrangement() == option.arrangement;
+  }
+
+  void ExecuteCommand(int command, int event_flags) override {
+    if (!IsCommandIdEnabled(command)) {
+      return;
+    }
+    const auto& option = kPaneLayouts[command - kFirstPaneLayoutCommand];
+    const double ratio = option.arrangement == split_tabs::SplitTabArrangement::kLinear
+                             ? static_cast<double>(split_tabs::FirstSplitPaneCount(
+                                   option.count, option.arrangement)) / option.count
+                             : 0.5;
+    split_tabs::SplitTabVisualData visual_data(option.orientation, ratio);
+    visual_data.set_arrangement(option.arrangement);
+    model_->CreateOrUpdatePaneSplit(model_->GetIndexOfTab(tab_.get()),
+                                    option.count, visual_data);
+  }
+
+ private:
+  raw_ptr<TabStripModel> model_;
+  base::WeakPtr<tabs::TabInterface> tab_;
+};
