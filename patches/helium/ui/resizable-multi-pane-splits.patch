+// Resize adjacent leaves without moving the other leaves in their group.
+inline std::array<double, 4> ResizeSplitPaneWeights(
+    std::array<double, 4> weights,
+    size_t first,
+    int initial_size,
+    int total_size,
+    int delta) {
+  if (first >= weights.size() - 1 || total_size <= 0) {
+    return weights;
+  }
+  const int minimum = std::min(80, total_size / 2);
+  int start = std::clamp(initial_size + delta, minimum, total_size - minimum);
+  if (std::abs(start - total_size / 2) <= 8) {
+    start = total_size / 2;
+  }
+  const double total_weight = weights[first] + weights[first + 1];
+  // Keep positive weights even when the window has almost no room left.
+  const double ratio = std::clamp(static_cast<double>(start) / total_size,
+                                  0.01, 0.99);
+  weights[first] = total_weight * ratio;
+  weights[first + 1] = total_weight * (1 - ratio);
+  return weights;
