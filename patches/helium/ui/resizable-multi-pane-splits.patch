+size_t MultiContentsView::FirstPaneAtBoundary(size_t boundary) const {
+  const size_t first_count = split_tabs::FirstSplitPaneCount(
+      pane_count_, visual_data_.arrangement());
+  return boundary < first_count - 1 ? boundary : boundary + 1;
+}
+
+void MultiContentsView::UpdatePaneResizeAreas() {
+  const bool vertical =
+      (GetSplitLayout() == split_tabs::SplitTabLayout::kSideBySide) !=
+      (visual_data_.arrangement() == split_tabs::SplitTabArrangement::kLinear);
+  for (size_t i = 0; i < pane_resize_areas_.size(); ++i) {
+    pane_resize_areas_[i]->SetLayout(
+        vertical ? split_tabs::SplitTabLayout::kStacked
+                 : split_tabs::SplitTabLayout::kSideBySide);
+    pane_resize_areas_[i]->SetVisible(i + 2 < pane_count_);
+  }
+}
+
+double MultiContentsView::GetPaneResizeRatio(size_t boundary) const {
+  const size_t first = FirstPaneAtBoundary(boundary);
+  const auto& weights = visual_data_.pane_weights();
+  return weights[first] / (weights[first] + weights[first + 1]);
+}
+
+void MultiContentsView::OnPaneResize(size_t boundary,
+                                    int resize_amount,
+                                    bool done_resizing) {
+  if (boundary + 2 >= pane_count_ ||
+      boundary >= pane_resize_areas_.size()) {
+    return;
+  }
+  const size_t first = FirstPaneAtBoundary(boundary);
+  auto& state = pane_resize_state_[boundary];
+  if (!state) {
+    const bool vertical = pane_resize_areas_[boundary]->axis() ==
+                          views::ResizeArea::Axis::kVertical;
+    const auto extent = [vertical](const views::View* pane) {
+      return vertical ? pane->height() : pane->width();
+    };
+    const int start = extent(contents_container_views_[first]);
+    state = PaneResizeState{visual_data_.pane_weights(), start,
+                           start + extent(contents_container_views_[first + 1])};
+  }
+  const auto weights = split_tabs::ResizeSplitPaneWeights(
+      state->weights, first, state->initial_size, state->total_size, resize_amount);
+  delegate_->ResizePaneContents(weights, done_resizing);
+  if (done_resizing) {
+    state.reset();
+  }
+}
