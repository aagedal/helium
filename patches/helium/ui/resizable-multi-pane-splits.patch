+void TabStripModel::UpdateSplitPaneWeights(
+    split_tabs::SplitTabId split_id,
+    const std::array<double, 4>& weights,
+    bool is_intermediate) {
+  ReentrancyCheck reentrancy_check(&reentrancy_guard_);
+  auto* split_data = GetSplitData(split_id);
+  const auto old_visual_data = *split_data->visual_data();
+  split_data->visual_data()->set_pane_weights(weights);
+  if (old_visual_data == *split_data->visual_data()) {
+    return;
+  }
+  NotifySplitTabVisualsChanged(
+      split_id, old_visual_data, *split_data->visual_data(),
+      SplitTabChange::SplitVisualChangeReason::kRatioUpdated, is_intermediate);
+}
