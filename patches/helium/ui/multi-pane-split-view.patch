+
+// Bounds for one leaf in the experimental four-pane grid. This helper has no
+// Views dependency, so the partitioning can be tested without a browser build.
+struct GridPaneBounds {
+  int x = 0;
+  int y = 0;
+  int width = 0;
+  int height = 0;
+};
+
+inline std::array<GridPaneBounds, 4> CalculateGridPaneBounds(
+    GridPaneBounds start,
+    GridPaneBounds end,
+    size_t pane_count,
+    SplitTabLayout layout) {
+  std::array<GridPaneBounds, 4> panes{};
+  if (pane_count < 2 || pane_count > panes.size()) {
+    return panes;
+  }
+  const size_t first_half_count = (pane_count + 1) / 2;
+  const auto subdivide = [&](GridPaneBounds bounds, size_t first, size_t count) {
+    for (size_t i = 0; i < count; ++i) {
+      auto pane = bounds;
+      const bool vertical = layout == SplitTabLayout::kSideBySide;
+      const int extent = vertical ? bounds.height : bounds.width;
+      const int begin = extent * static_cast<int>(i) / static_cast<int>(count);
+      const int limit =
+          extent * static_cast<int>(i + 1) / static_cast<int>(count);
+      if (vertical) {
+        pane.y += begin;
+        pane.height = limit - begin;
+      } else {
+        pane.x += begin;
+        pane.width = limit - begin;
+      }
+      panes[first + i] = pane;
+    }
+  };
+  subdivide(start, 0, first_half_count);
+  subdivide(end, first_half_count, pane_count - first_half_count);
+  return panes;
+}
 
