+    // Deselecting the only selected collection must retain a selection.
+    tabstrip()->DeselectTabAt(index);
+    EXPECT_EQ(4u, tabstrip()->selection_model().size());
+  }
+  tabstrip()->ActivateTabAt(5);
+  EXPECT_EQ(1u, tabstrip()->GetForegroundTabs().size());
+  tabstrip()->ActivateTabAt(3);
+  tabstrip()->RemoveSplit(split_id);
+  EXPECT_EQ(3, tabstrip()->active_index());
+  EXPECT_EQ(1u, tabstrip()->GetForegroundTabs().size());
+  EXPECT_EQ("0 1 2 3 4 5", GetTabStripStateString(tabstrip()));
+}
