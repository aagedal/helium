+// Copyright 2026 The Helium Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+#ifndef CHROME_BROWSER_UI_TABS_PAGE_CHANGE_MONITOR_DIFF_H_
+#define CHROME_BROWSER_UI_TABS_PAGE_CHANGE_MONITOR_DIFF_H_
+
+#include <algorithm>
+#include <cstdint>
+#include <string>
+#include <string_view>
+#include <vector>
+
+namespace tabs {
+struct PageChangeLine {
+  enum class Kind { kContext, kRemoved, kAdded, kGap, kTruncated };
+  Kind kind;
+  std::string text;
+  // Number of unchanged lines summarized by a kGap row.
+  size_t hidden = 0;
+};
+
+// Review-only line diff. Whole lines are compared so shared word endings
+// cannot turn Wednesday/Thursday into Wedne/Thur. The LCS table is bounded;
+// larger edits fall back to showing the changed block as removed + added.
+inline std::vector<PageChangeLine> BuildPageChangeLines(
+    std::string_view before,
+    std::string_view after,
+    size_t context = 2,
+    size_t max_rows = 300,
+    size_t max_line_bytes = 2000) {
+  using Kind = PageChangeLine::Kind;
+  std::vector<PageChangeLine> rows;
+  if (before == after) {
+    return rows;
+  }
+  const auto lines = [](std::string_view text) {
+    std::vector<std::string_view> result;
+    if (text.empty()) {
+      return result;
+    }
+    size_t start = 0;
+    while (true) {
+      const auto newline = text.find('\n', start);
+      if (newline == std::string_view::npos) {
+        result.push_back(text.substr(start));
+        break;
+      }
+      result.push_back(text.substr(start, newline - start));
+      start = newline + 1;
+    }
+    return result;
+  };
+  const auto old_lines = lines(before), new_lines = lines(after);
+  size_t prefix = 0;
+  while (prefix < old_lines.size() && prefix < new_lines.size() &&
+         old_lines[prefix] == new_lines[prefix]) {
+    ++prefix;
+  }
+  size_t suffix = 0;
+  while (suffix < old_lines.size() - prefix &&
+         suffix < new_lines.size() - prefix &&
+         old_lines[old_lines.size() - 1 - suffix] ==
+             new_lines[new_lines.size() - 1 - suffix]) {
+    ++suffix;
+  }
+
+  // Edit script over the whole text.
+  struct Op {
+    Kind kind;
+    std::string_view text;
+  };
+  std::vector<Op> ops;
+  for (size_t i = 0; i < prefix; ++i) {
+    ops.push_back({Kind::kContext, old_lines[i]});
+  }
+  const size_t m = old_lines.size() - prefix - suffix;
+  const size_t n = new_lines.size() - prefix - suffix;
+  const auto old_at = [&](size_t i) { return old_lines[prefix + i]; };
+  const auto new_at = [&](size_t j) { return new_lines[prefix + j]; };
+  // Show each run of edits as its removals followed by its additions.
+  std::vector<Op> removed, added;
+  const auto flush = [&] {
+    ops.insert(ops.end(), removed.begin(), removed.end());
+    ops.insert(ops.end(), added.begin(), added.end());
+    removed.clear();
+    added.clear();
+  };
+  if (m && n && (m + 1) * (n + 1) <= 1000000) {
+    // table[i][j] = LCS length of old[i..] and new[j..]; min(m, n) < 1000.
+    const size_t width = n + 1;
+    std::vector<uint16_t> table((m + 1) * width, 0);
+    for (size_t i = m; i-- > 0;) {
+      for (size_t j = n; j-- > 0;) {
+        table[i * width + j] = old_at(i) == new_at(j)
+                                   ? table[(i + 1) * width + j + 1] + 1
+                                   : std::max(table[(i + 1) * width + j],
+                                              table[i * width + j + 1]);
+      }
+    }
+    size_t i = 0, j = 0;
+    while (i < m || j < n) {
+      if (i < m && j < n && old_at(i) == new_at(j)) {
+        flush();
+        ops.push_back({Kind::kContext, old_at(i)});
+        ++i;
+        ++j;
+      } else if (j < n && (i == m || table[i * width + j + 1] >=
+                                         table[(i + 1) * width + j])) {
+        added.push_back({Kind::kAdded, new_at(j++)});
+      } else {
+        removed.push_back({Kind::kRemoved, old_at(i++)});
+      }
+    }
+  } else {
+    for (size_t i = 0; i < m; ++i) {
+      removed.push_back({Kind::kRemoved, old_at(i)});
+    }
+    for (size_t j = 0; j < n; ++j) {
+      added.push_back({Kind::kAdded, new_at(j)});
+    }
+  }
+  flush();
+  for (size_t i = old_lines.size() - suffix; i < old_lines.size(); ++i) {
+    ops.push_back({Kind::kContext, old_lines[i]});
+  }
+
+  const auto clip = [max_line_bytes](std::string_view text) {
+    if (text.size() <= max_line_bytes) {
+      return std::string(text);
+    }
+    size_t end = max_line_bytes;
+    // Do not cut a UTF-8 sequence at the byte budget.
+    while (end > 0 && (static_cast<unsigned char>(text[end]) & 0xc0) == 0x80) {
+      --end;
+    }
+    return std::string(text.substr(0, end)) + "…";
+  };
+  // Keep unchanged lines only near an edit; summarize the rest as gaps.
+  std::vector<bool> keep(ops.size(), false);
+  for (size_t k = 0; k < ops.size(); ++k) {
+    if (ops[k].kind != Kind::kContext) {
+      const size_t from = k > context ? k - context : 0;
+      const size_t to = std::min(ops.size(), k + context + 1);
+      std::fill(keep.begin() + from, keep.begin() + to, true);
+    }
+  }
+  for (size_t k = 0; k < ops.size();) {
+    if (rows.size() >= max_rows) {
+      rows.push_back({Kind::kTruncated, std::string()});
+      break;
+    }
+    if (!keep[k]) {
+      size_t end = k;
+      while (end < ops.size() && !keep[end]) {
+        ++end;
+      }
+      rows.push_back({Kind::kGap, std::string(), end - k});
+      k = end;
+      continue;
+    }
+    rows.push_back({ops[k].kind, clip(ops[k].text)});
+    ++k;
+  }
+  return rows;
+}
+}  // namespace tabs
+#endif  // CHROME_BROWSER_UI_TABS_PAGE_CHANGE_MONITOR_DIFF_H_
