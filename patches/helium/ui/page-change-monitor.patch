+
+bool WriteExport(const base::FilePath& path,
+                 std::string bytes,
+                 base::DictValue record) {
+  if (bytes.empty() || bytes.size() > 32 * 1024 * 1024) {
+    return false;
+  }
+  record.Set("sha256", base::HexEncodeLower(crypto::SHA256HashString(bytes)));
+  std::string json;
+  if (!base::JSONWriter::WriteWithOptions(
+          record, base::JSONWriter::OPTIONS_PRETTY_PRINT, &json)) {
+    return false;
+  }
+  if (!base::ImportantFileWriter::WriteFileAtomically(path, bytes)) {
+    return false;
+  }
+  if (!base::ImportantFileWriter::WriteFileAtomically(
+          path.AddExtension(FILE_PATH_LITERAL("json")), json)) {
+    base::DeleteFile(path);
+    return false;
+  }
+  return true;
+}
