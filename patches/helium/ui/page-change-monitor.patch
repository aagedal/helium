+TEST_F(PaneSettingsTest, MonitoringRestoresWithoutUnattendedExports) {
+  auto* settings = PaneSettings::GetOrCreate(web_contents());
+  settings->SetMonitorSelector("#statement");
+  settings->SetMonitorExports(true, true);
+  settings->SetRefreshJitter(true);
+  std::map<std::string, std::string> data;
+  PaneSettings::PopulateExtraData(web_contents(), &data);
+  settings->SetMonitorSelector("");
+  settings->SetRefreshJitter(false);
+  PaneSettings::RestoreFromExtraData(web_contents(), data);
+  EXPECT_EQ(settings->monitor_selector(), "#statement");
+  EXPECT_TRUE(settings->refresh_jitter());
+  EXPECT_FALSE(settings->monitor_screenshot());
+  EXPECT_FALSE(settings->monitor_pdf());
+}
