+void PageChangeMonitor::ChooseExportFolder() {
+  if (folder_dialog_) {
+    return;
+  }
+  base::FilePath initial_folder;
+#if !BUILDFLAG(IS_CHROMEOS)
+  auto* prefs = Profile::FromBrowserContext(web_contents()->GetBrowserContext())
+                    ->GetPrefs();
+  initial_folder = prefs->GetFilePath(sharing_hub::kScreenshotDirectoryPref);
+#endif
