+// One line of the review diff, tinted by whether it was removed or added.
+class ChangeRow : public views::View {
+  METADATA_HEADER(ChangeRow, views::View)
+
+ public:
+  ChangeRow(PageChangeLine::Kind kind, std::u16string text, int width)
+      : kind_(kind) {
+    using Kind = PageChangeLine::Kind;
+    const bool note = kind == Kind::kGap || kind == Kind::kTruncated;
+    auto* layout = SetLayoutManager(std::make_unique<views::BoxLayout>(
+        views::BoxLayout::Orientation::kHorizontal, gfx::Insets::VH(4, 8), 8));
+    layout->set_cross_axis_alignment(
+        views::BoxLayout::CrossAxisAlignment::kStart);
+    marker_ = AddChildView(
+        std::make_unique<views::Label>(kind == Kind::kRemoved ? u"\u2212"
+                                       : kind == Kind::kAdded ? u"+"
+                                       : note                 ? u"\u22ef"
+                                                              : u"",
+                                       views::style::CONTEXT_DIALOG_BODY_TEXT,
+                                       views::style::STYLE_EMPHASIZED));
+    marker_->SetPreferredSize(gfx::Size(14, marker_->GetLineHeight()));
+    auto* label = AddChildView(std::make_unique<views::Label>(
+        text, views::style::CONTEXT_DIALOG_BODY_TEXT,
+        note || kind == Kind::kContext ? views::style::STYLE_SECONDARY
+                                       : views::style::STYLE_PRIMARY));
+    label->SetMultiLine(true);
+    label->SetAllowCharacterBreak(true);
+    label->SetHorizontalAlignment(gfx::ALIGN_LEFT);
+    label->SetMaximumWidth(width - 14 - 8 - 16);
+    layout->SetFlexForView(label, 1);
+    GetViewAccessibility().SetRole(ax::mojom::Role::kListItem);
+    GetViewAccessibility().SetName(
+        kind == Kind::kRemoved
+            ? l10n_util::GetStringFUTF16(IDS_NEO_MONITOR_LINE_REMOVED, text)
+        : kind == Kind::kAdded
+            ? l10n_util::GetStringFUTF16(IDS_NEO_MONITOR_LINE_ADDED, text)
+            : text);
+  }
+
+  void OnThemeChanged() override {
+    views::View::OnThemeChanged();
+    using Kind = PageChangeLine::Kind;
+    if (kind_ != Kind::kRemoved && kind_ != Kind::kAdded) {
+      return;
+    }
+    const auto* colors = GetColorProvider();
+    const SkColor accent =
+        colors->GetColor(kind_ == Kind::kRemoved ? ui::kColorAlertHighSeverity
+                                                 : ui::kColorAlertLowSeverity);
+    SetBackground(views::CreateRoundedRectBackground(
+        color_utils::AlphaBlend(
+            accent, colors->GetColor(ui::kColorDialogBackground), 0.16f),
+        4));
+    marker_->SetEnabledColor(accent);
+  }
+
+ private:
+  const PageChangeLine::Kind kind_;
+  raw_ptr<views::Label> marker_ = nullptr;
+};
