+void PageChangeMonitor::ChooseExportFolder() {
+  if (folder_dialog_) {
+    return;
+  }
+  base::FilePath initial_folder;
+#if !BUILDFLAG(IS_CHROMEOS)
+  auto* prefs = Profile::FromBrowserContext(web_contents()->GetBrowserContext())
+                    ->GetPrefs();
+  initial_folder = prefs->GetFilePath(sharing_hub::kScreenshotDirectoryPref);
+#endif
+  folder_dialog_ = ui::SelectFileDialog::Create(
+      this, std::make_unique<ChromeSelectFilePolicy>(web_contents()));
+  folder_dialog_->SelectFile(ui::SelectFileDialog::SELECT_FOLDER,
+                             Text(IDS_NEO_MONITOR_FOLDER), initial_folder,
+                             nullptr, 0, base::FilePath::StringType(),
+                             web_contents()->GetTopLevelNativeWindow());
+}
