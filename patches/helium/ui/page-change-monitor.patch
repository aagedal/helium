+// Copyright 2026 The Helium Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+#ifndef CHROME_BROWSER_UI_TABS_PAGE_CHANGE_MONITOR_SCRIPT_H_
+#define CHROME_BROWSER_UI_TABS_PAGE_CHANGE_MONITOR_SCRIPT_H_
+
+namespace tabs {
+// Evaluated only on opt-in and after a completed load, in an isolated world.
+// Limits fail closed: incomplete text must never become a new baseline.
+inline constexpr char kPageChangeMonitorScript[] = R"JS(
+(scope => {
+  const started = performance.now();
+  const MAX_NODES = 4000, MAX_TEXT = 65536, MAX_MS = 12;
+  const excluded = 'script,style,noscript,template,nav,header,footer,aside,[hidden],[aria-hidden="true"],input,textarea,select,[contenteditable]:not([contenteditable="false"])';
+  let roots;
+  if (scope === '@main') {
+    // Prefer article text; ordinary documents can fall back to their body.
+    roots = [document.querySelector('article') || document.querySelector('main') || document.body];
+  } else {
+    // A picked section may be a list of sibling blocks; all must still exist.
+    try { roots = [...document.querySelectorAll(scope)]; }
+    catch (_) { return {error: 'The watched section selector is invalid.'}; }
+    if (roots.length !== scope.split(/(?<!\\),/).length) roots = [];
+  }
+  if (!roots.length || roots.some(root => !root || root.closest(excluded)))
+    return {error: 'The watched section is missing. Keeping the previous version.'};
+  let visited = 0, size = 0;
+  const lines = [];
+  for (const root of roots) {
+    for (let ancestor = root; ancestor; ancestor = ancestor.parentElement) {
+      if (++visited > MAX_NODES || performance.now() - started > MAX_MS)
+        return {error: 'Scan limit reached. Select a smaller section to watch.'};
+      const style = getComputedStyle(ancestor);
+      if (style.display === 'none' || style.visibility !== 'visible' ||
+          style.contentVisibility === 'hidden' || style.opacity === '0')
+        return {error: 'The watched section is hidden. Keeping the previous version.'};
+    }
+    // Manual traversal can stop immediately; TreeWalker filters can otherwise
+    // keep visiting rejected siblings after a budget is exhausted.
+    let node = root.firstChild;
+    while (node) {
+      if (++visited > MAX_NODES || performance.now() - started > MAX_MS)
+        return {error: 'Scan limit reached. Select a smaller section to watch.'};
+      let descend = true;
+      if (node.nodeType === Node.ELEMENT_NODE) {
+        const style = getComputedStyle(node);
+        descend = !node.matches(excluded) && style.display !== 'none' &&
+          style.visibility === 'visible' && style.contentVisibility !== 'hidden' && style.opacity !== '0';
+      } else if (node.nodeType === Node.TEXT_NODE) {
+        if (node.length > MAX_TEXT || size + node.length + 1 > MAX_TEXT)
+          return {error: 'Too much text. Select a smaller section to watch.'};
+        const text = node.data.replace(/\s+/g, ' ').trim();
+        size += node.length + 1;
+        if (text) lines.push(text);
+      }
+      if (descend && node.firstChild) { node = node.firstChild; continue; }
+      while (node && node !== root && !node.nextSibling) node = node.parentNode;
+      if (!node || node === root) break;
+      node = node.nextSibling;
+    }
+  }
+  const text = lines.join('\n');
+  if (!text) return {error: 'No readable text found. Keeping the previous version.'};
+  return {text, nodes: visited};
+})
+)JS";
+
+// Interactive section picker, called as picker(scan, strings) with the scan
+// function above. Dragging outlines the blocks of text inside the rectangle;
+// a click picks the block under the pointer. Results
+// are left in the isolated world for kPageChangeMonitorPollScript, because
+// isolated-world execution cannot wait for a promise.
+inline constexpr char kPageChangeMonitorPickerScript[] = R"JS(
+((scan, strings) => {
+  globalThis.heliumNeoPicker?.cancel();
+  const blocks = 'p,li,dd,dt,td,th,pre,blockquote,figure,h1,h2,h3,h4,h5,h6,' +
+    'table,ul,ol,dl,section,article,main,div,body';
+  const host = document.createElement('div');
+  host.style.cssText = 'all:initial;position:fixed;inset:0;z-index:2147483647;';
+  const shadow = host.attachShadow({mode: 'closed'});
+  const sheet = new CSSStyleSheet();
+  sheet.replaceSync(`
+    * { box-sizing: border-box; }
+    .layer { position: fixed; inset: 0; cursor: crosshair; background: rgb(0 0 0 / .08); }
+    .box { position: fixed; pointer-events: none; display: none; border-radius: 4px; }
+    .target { border: 2px solid #1a73e8; background: rgb(26 115 232 / .12);
+              box-shadow: 0 0 0 9999px rgb(0 0 0 / .18); }
+    .target.done { border-color: #188038; background: rgb(24 128 56 / .14); }
+    .drag { border: 1.5px dashed #1a73e8; }
+    .tag { position: absolute; left: -2px; bottom: 100%; margin-bottom: 4px;
+           max-width: min(420px, 90vw); overflow: hidden; white-space: nowrap;
+           text-overflow: ellipsis; padding: 3px 8px; border-radius: 4px;
+           background: #1a73e8; color: white; font: 12px/1.4 system-ui, sans-serif; }
+    .target.below .tag { bottom: auto; top: 100%; margin: 4px 0 0; }
+    .target.done .tag { background: #188038; }
+    .bar { position: fixed; top: 12px; left: 50%; transform: translateX(-50%);
+           display: flex; align-items: center; gap: 12px; max-width: calc(100vw - 24px);
+           padding: 8px 8px 8px 14px; border-radius: 10px; background: rgb(32 33 36 / .94);
+           color: white; font: 13px/1.4 system-ui, sans-serif;
+           box-shadow: 0 4px 16px rgb(0 0 0 / .3); }
+    .bar.error { background: rgb(165 14 14 / .95); }
+    button { font: inherit; color: inherit; background: rgb(255 255 255 / .16);
+             border: 0; border-radius: 6px; padding: 4px 12px; cursor: pointer; }
+    button:hover { background: rgb(255 255 255 / .26); }
+  `);
+  shadow.adoptedStyleSheets = [sheet];
+  const make = (tag, className, parent = shadow) => {
+    const element = document.createElement(tag);
+    element.className = className;
+    parent.append(element);
+    return element;
+  };
+  const layer = make('div', 'layer');
+  const drag = make('div', 'box drag');
+  const target = make('div', 'box target');
+  const tag = make('div', 'tag', target);
+  const bar = make('div', 'bar');
+  bar.setAttribute('role', 'status');
+  const message = make('span', 'message', bar);
+  const cancelButton = make('button', 'cancel', bar);
+  message.textContent = strings.hint;
+  cancelButton.textContent = strings.cancel;
+
+  const picker = {result: null};
+  let start = null, current = [], frame = 0, finished = false;
+  const under = (x, y) => document.elementsFromPoint(x, y).find(e => e !== host);
+  const hasText = element => !!element && /\S/.test(element.textContent || '');
+  const blockOf = element => {
+    if (element === document.documentElement) element = document.body;
+    return hasText(element) ? element.closest(blocks) || element : null;
+  };
+  // A click on the page margin or an empty box must not pick the whole page.
+  const pickAt = (x, y) => {
+    const element = under(x, y);
+    const block = element === document.body ||
+        element === document.documentElement ? null : blockOf(element);
+    return block ? [block] : [];
+  };
+  const common = (a, b) => {
+    const ancestors = new Set();
+    for (let e = a; e; e = e.parentElement) ancestors.add(e);
+    for (let e = b; e; e = e.parentElement) if (ancestors.has(e)) return e;
+    return null;
+  };
+  const overlaps = (r, rect) => r.width && r.height &&
+      r.right > rect.left && r.left < rect.left + rect.width &&
+      r.bottom > rect.top && r.top < rect.top + rect.height;
+  // Sample the rectangle instead of walking the DOM so huge pages stay cheap.
+  const pickInRect = rect => {
+    let found = null;
+    const steps = 6;
+    for (let i = 0; i <= steps; ++i) {
+      for (let j = 0; j <= steps; ++j) {
+        const element = under(rect.left + rect.width * i / steps,
+                              rect.top + rect.height * j / steps);
+        if (!hasText(element)) continue;
+        found = found ? common(found, element) : element;
+      }
+    }
+    const block = blockOf(found);
+    if (!block) return [];
+    // Two paragraphs of a long article should not watch the whole article:
+    // keep only the child blocks the rectangle touches.
+    if ([...block.childNodes].some(n => n.nodeType === Node.TEXT_NODE && /\S/.test(n.data)))
+      return [block];
+    const children = [...block.children].slice(0, 500).filter(hasText);
+    const inside = children.filter(child => overlaps(child.getBoundingClientRect(), rect));
+    return inside.length && inside.length < children.length ? inside : [block];
+  };
+  const selectorOf = element => {
+    if (element === document.body) return 'body';
+    const parts = [];
+    for (let e = element; e && e !== document.documentElement; e = e.parentElement) {
+      if (parts.length >= 24) return '';
+      if (e.id && e.id.length <= 256 &&
+          document.querySelectorAll('#' + CSS.escape(e.id)).length === 1) {
+        parts.unshift('#' + CSS.escape(e.id));
