+WEB_CONTENTS_USER_DATA_KEY_IMPL(PageChangeMonitor);
+
+PageChangeMonitor::PageChangeMonitor(content::WebContents* contents)
+    : content::WebContentsObserver(contents),
+      content::WebContentsUserData<PageChangeMonitor>(*contents) {
+  settings_subscription_ =
+      PaneSettings::GetOrCreate(contents)->RegisterChanged(base::BindRepeating(
+          &PageChangeMonitor::SettingsChanged, base::Unretained(this)));
+  status_ = Text(IDS_NEO_MONITOR_OFF);
+  SettingsChanged();
+}
+
+PageChangeMonitor::~PageChangeMonitor() {
+  if (exports_pending_ > 0) {
+    --g_active_monitor_exports;
+  }
+  if (folder_dialog_) {
+    folder_dialog_->ListenerDestroyed();
+  }
+}
+
+PageChangeMonitor* PageChangeMonitor::GetOrCreate(
+    content::WebContents* contents) {
+  CreateForWebContents(contents);
+  return FromWebContents(contents);
+}
+
+void PageChangeMonitor::UpdateBlocked() {
+  if (web_contents()) {
+    PaneSettings::GetOrCreate(web_contents())
+        ->SetRefreshBlocked(scanning_ || picking_ ||
+                            settle_timer_.IsRunning() || exports_pending_ > 0);
+  }
+}
+
+void PageChangeMonitor::CancelPending() {
+  ++generation_;
+  settle_timer_.Stop();
+  scan_timeout_.Stop();
+  scanning_ = false;
+  UpdateBlocked();
+}
+
+void PageChangeMonitor::SettingsChanged() {
+  auto* settings = PaneSettings::GetOrCreate(web_contents());
+  if (selector_ == settings->monitor_selector()) {
+    return;
+  }
+  CancelPicker(true);
+  CancelPending();
+  selector_ = settings->monitor_selector();
+  watched_url_ = web_contents()->GetLastCommittedURL().GetWithoutRef();
+  baseline_.clear();
+  before_.clear();
+  after_.clear();
+  last_check_.clear();
+  change_time_.clear();
+  last_check_value_ = base::Time();
+  change_time_value_ = base::Time();
+  has_change_ = false;
+  SetAttention(false);
+  status_ =
+      Text(selector_.empty() ? IDS_NEO_MONITOR_OFF : IDS_NEO_MONITOR_WAITING);
+  if (!selector_.empty()) {
+    ScheduleScan();
+  }
+}
+
+void PageChangeMonitor::ScheduleScan() {
+  if (selector_.empty() || scanning_ || exports_pending_ || picking_ ||
+      web_contents()->IsLoading()) {
+    return;
+  }
+  settle_timer_.Start(
+      FROM_HERE, base::Milliseconds(750),
+      base::BindOnce(&PageChangeMonitor::Scan, weak_factory_.GetWeakPtr()));
+  UpdateBlocked();
+}
+
+void PageChangeMonitor::DidStopLoading() {
+  if (!selector_.empty()) {
+    ScheduleScan();
+  }
+}
+
+void PageChangeMonitor::DidStartNavigation(content::NavigationHandle* handle) {
+  if (handle->IsInPrimaryMainFrame() && !handle->IsSameDocument()) {
+    CancelPicker(false);
+    CancelPending();
+  }
+}
+
+void PageChangeMonitor::DidFinishNavigation(content::NavigationHandle* handle) {
+  if (!handle->IsInPrimaryMainFrame() || !handle->HasCommitted()) {
+    return;
+  }
+  if (!selector_.empty() && !watched_url_.is_empty() &&
+      handle->GetURL().GetWithoutRef() != watched_url_) {
+    // Never carry a watched region or automatic exports onto another page.
+    PaneSettings::GetOrCreate(web_contents())->SetMonitorSelector("");
+    PaneSettingsMenuModel::SaveWorkspaceSettingsForTab(
+        TabInterface::MaybeGetFromContents(web_contents()));
+    status_ = Text(IDS_NEO_MONITOR_NAVIGATED);
+  }
+}
+
+void PageChangeMonitor::WebContentsDestroyed() {
+  picking_ = false;
+  picker_timer_.Stop();
+  CancelPending();
+  settings_subscription_ = {};
+  weak_factory_.InvalidateWeakPtrs();
+  if (folder_dialog_) {
+    folder_dialog_->ListenerDestroyed();
+    folder_dialog_ = nullptr;
+  }
+}
+
+bool PageChangeMonitor::CanReadPage() {
+#if BUILDFLAG(IS_MAC)
+  if (helium::GetWebKitStreamingTabView(web_contents())) {
+    return false;
+  }
+#endif
+  auto* frame = web_contents()->GetPrimaryMainFrame();
+  const auto* entry = web_contents()->GetController().GetLastCommittedEntry();
+  return !web_contents()->IsLoading() && entry &&
+         entry->GetPageType() == content::PAGE_TYPE_NORMAL &&
+         web_contents()->GetLastCommittedURL().SchemeIsHTTPOrHTTPS() &&
+         !web_contents()->GetController().NeedsReload() && frame &&
+         frame->IsRenderFrameLive();
+}
+
+void PageChangeMonitor::StartPicker() {
+  base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE, base::BindOnce(&PageChangeMonitor::ShowPicker,
+                                weak_factory_.GetWeakPtr()));
+}
+
+void PageChangeMonitor::ShowPicker() {
+  CancelPicker(true);
+  if (!CanReadPage()) {
+    status_ = Text(IDS_NEO_MONITOR_PAUSED);
+    return;
+  }
+  base::DictValue strings;
+  strings.Set("hint", Text(IDS_NEO_MONITOR_PICK_HINT));
+  strings.Set("cancel", Text(IDS_NEO_MONITOR_PICK_CANCEL));
+  strings.Set("empty", Text(IDS_NEO_MONITOR_PICK_EMPTY));
+  strings.Set("done", Text(IDS_NEO_MONITOR_PICK_DONE));
+  std::string argument;
+  base::JSONWriter::Write(strings, &argument);
+  picking_ = true;
+  picker_poll_pending_ = true;
+  status_ = Text(IDS_NEO_MONITOR_PICKING);
+  UpdateBlocked();
+  // A user may take a while to choose, but never leave the overlay forever.
+  picker_deadline_ = base::TimeTicks::Now() + base::Minutes(3);
+  picker_timer_.Start(FROM_HERE, base::Milliseconds(250),
+                      base::BindRepeating(&PageChangeMonitor::PollPicker,
+                                          base::Unretained(this)));
+  web_contents()->GetPrimaryMainFrame()->ExecuteJavaScriptInIsolatedWorld(
+      base::UTF8ToUTF16(std::string(kPageChangeMonitorPickerScript) + "(" +
+                        kPageChangeMonitorScript + "," + argument + ")"),
+      base::BindOnce(&PageChangeMonitor::PickerPolled,
+                     weak_factory_.GetWeakPtr(), picker_generation_),
+      ISOLATED_WORLD_ID_CHROME_INTERNAL);
+  // Escape must reach the page rather than the tab strip.
+  web_contents()->Focus();
+}
+
+void PageChangeMonitor::PollPicker() {
+  if (!picking_) {
+    return;
+  }
+  if (base::TimeTicks::Now() >= picker_deadline_) {
+    CancelPicker(true);
+    return;
+  }
+  auto* frame = web_contents()->GetPrimaryMainFrame();
+  if (!frame || !frame->IsRenderFrameLive()) {
+    CancelPicker(false);
+    return;
+  }
+  if (picker_poll_pending_) {
+    return;
+  }
+  picker_poll_pending_ = true;
+  frame->ExecuteJavaScriptInIsolatedWorld(
+      base::UTF8ToUTF16(std::string_view(kPageChangeMonitorPollScript)),
+      base::BindOnce(&PageChangeMonitor::PickerPolled,
+                     weak_factory_.GetWeakPtr(), picker_generation_),
+      ISOLATED_WORLD_ID_CHROME_INTERNAL);
+}
+
+void PageChangeMonitor::PickerPolled(int generation, base::Value result) {
+  if (!picking_ || generation != picker_generation_) {
+    return;
+  }
+  picker_poll_pending_ = false;
+  const auto* data = result.GetIfDict();
+  const auto* state = data ? data->FindString("state") : nullptr;
+  if (state && *state == "picking") {
+    return;
+  }
+  const auto* selector = data ? data->FindString("selector") : nullptr;
+  CancelPicker(false);
+  if (state && *state == "done" && selector && !selector->empty() &&
+      selector->size() <= 2048 && *selector != selector_) {
+    // SettingsChanged resets the history and takes a fresh baseline.
+    PaneSettings::GetOrCreate(web_contents())->SetMonitorSelector(*selector);
+    PaneSettingsMenuModel::SaveWorkspaceSettingsForTab(
+        TabInterface::MaybeGetFromContents(web_contents()));
+  }
+}
+
+void PageChangeMonitor::CancelPicker(bool remove_overlay) {
+  if (!picking_) {
+    return;
+  }
+  picking_ = false;
+  picker_poll_pending_ = false;
+  ++picker_generation_;
+  picker_timer_.Stop();
+  // Keep describing the section that is still watched, if any.
+  status_ = Text(selector_.empty()   ? IDS_NEO_MONITOR_PICK_CANCELLED
+                 : has_change_       ? IDS_NEO_MONITOR_CHANGED
+                 : baseline_.empty() ? IDS_NEO_MONITOR_WAITING
+                                     : IDS_NEO_MONITOR_UNCHANGED);
+  auto* frame = web_contents()->GetPrimaryMainFrame();
+  if (remove_overlay && frame && frame->IsRenderFrameLive()) {
+    frame->ExecuteJavaScriptInIsolatedWorld(
+        base::UTF8ToUTF16(std::string_view(kPageChangeMonitorCancelScript)), {},
+        ISOLATED_WORLD_ID_CHROME_INTERNAL);
+  }
+  UpdateBlocked();
+  // Loads finished while the picker was open were not checked.
+  if (!selector_.empty() && baseline_.empty()) {
+    ScheduleScan();
+  }
+}
+
+void PageChangeMonitor::StopMonitoring() {
+  CancelPicker(true);
+  PaneSettings::GetOrCreate(web_contents())->SetMonitorSelector("");
+  PaneSettingsMenuModel::SaveWorkspaceSettingsForTab(
+      TabInterface::MaybeGetFromContents(web_contents()));
+}
+
+void PageChangeMonitor::Scan() {
+  if (selector_.empty() || scanning_ || exports_pending_ || picking_ ||
+      !CanReadPage()) {
+    status_ = Text(IDS_NEO_MONITOR_PAUSED);
+    UpdateBlocked();
+    return;
+  }
+  auto* frame = web_contents()->GetPrimaryMainFrame();
+  std::string argument;
+  base::JSONWriter::Write(base::Value(selector_), &argument);
+  scanning_ = true;
+  UpdateBlocked();
+  scan_timeout_.Start(FROM_HERE, base::Seconds(2),
+                      base::BindOnce(&PageChangeMonitor::ScanTimedOut,
+                                     weak_factory_.GetWeakPtr(), generation_));
+  frame->ExecuteJavaScriptInIsolatedWorld(
+      base::UTF8ToUTF16(std::string(kPageChangeMonitorScript) + "(" + argument +
+                        ")"),
+      base::BindOnce(&PageChangeMonitor::ScanComplete,
+                     weak_factory_.GetWeakPtr(), generation_),
+      ISOLATED_WORLD_ID_CHROME_INTERNAL);
+}
+
+void PageChangeMonitor::ScanTimedOut(int generation) {
+  if (generation != generation_) {
+    return;
+  }
+  ++generation_;  // Ignore a late renderer reply.
+  scanning_ = false;
+  status_ = Text(IDS_NEO_MONITOR_TIMEOUT);
+  UpdateBlocked();
+}
+
+void PageChangeMonitor::ScanComplete(int generation, base::Value result) {
+  if (generation != generation_) {
+    return;
+  }
+  scan_timeout_.Stop();
+  scanning_ = false;
+  UpdateBlocked();
+  const auto* data = result.GetIfDict();
+  const auto* text = data ? data->FindString("text") : nullptr;
+  if (!text || text->empty() || text->size() > 262144) {
+    const auto* error = data ? data->FindString("error") : nullptr;
+    status_ = error ? base::UTF8ToUTF16(*error) : Text(IDS_NEO_MONITOR_FAILED);
+    return;
+  }
+  if (watched_url_.is_empty()) {
+    watched_url_ = web_contents()->GetLastCommittedURL().GetWithoutRef();
+  }
+  last_check_value_ = base::Time::Now();
+  last_check_ = base::TimeFormatAsIso8601(last_check_value_);
+  if (baseline_.empty()) {
+    baseline_ = *text;
+    status_ = Text(IDS_NEO_MONITOR_BASELINE);
+  } else if (baseline_ != *text) {
+    before_ = std::move(baseline_);
+    after_ = *text;
+    baseline_ = *text;
+    change_time_ = last_check_;
+    change_time_value_ = last_check_value_;
+    has_change_ = true;
+    status_ = Text(IDS_NEO_MONITOR_CHANGED);
+    SetAttention(true);
+    ExportChange();
+  } else {
+    status_ =
+        Text(has_change_ ? IDS_NEO_MONITOR_CHANGED : IDS_NEO_MONITOR_UNCHANGED);
+  }
+}
+
+void PageChangeMonitor::SetAttention(bool attention) {
+  if (auto* tab = TabInterface::MaybeGetFromContents(web_contents())) {
+    if (auto* helper = TabUIHelper::From(tab)) {
+      helper->SetNeedsAttention(attention);
+    }
+  }
+}
+
+void PageChangeMonitor::ShowChanges() {
+  constexpr int kWidth = 600;
+  auto dialog = std::make_unique<views::DialogDelegate>();
+  dialog->SetTitle(Text(IDS_NEO_MONITOR_TITLE));
+  dialog->SetButtons(static_cast<int>(ui::mojom::DialogButton::kOk));
+  dialog->SetButtonLabel(ui::mojom::DialogButton::kOk,
+                         Text(IDS_NEO_MONITOR_CLOSE));
+  dialog->set_fixed_width(kWidth + 2 * 20);
+  dialog->SetShowCloseButton(true);
+  auto body = std::make_unique<views::View>();
+  body->SetLayoutManager(std::make_unique<views::BoxLayout>(
+      views::BoxLayout::Orientation::kVertical, gfx::Insets::VH(4, 20), 12));
+
+  // Page identity.
+  auto* page = body->AddChildView(std::make_unique<views::View>());
+  page->SetLayoutManager(std::make_unique<views::BoxLayout>(
+      views::BoxLayout::Orientation::kVertical, gfx::Insets(), 2));
+  auto* title = page->AddChildView(std::make_unique<views::Label>(
+      web_contents()->GetTitle(), views::style::CONTEXT_DIALOG_BODY_TEXT,
+      views::style::STYLE_EMPHASIZED));
+  title->SetHorizontalAlignment(gfx::ALIGN_LEFT);
+  title->SetElideBehavior(gfx::ELIDE_TAIL);
+  title->SetMaximumWidthSingleLine(kWidth);
+  const GURL& url = watched_url_.is_empty()
+                        ? web_contents()->GetLastCommittedURL()
+                        : watched_url_;
+  auto* address = page->AddChildView(std::make_unique<views::Label>(
+      base::UTF8ToUTF16(url.spec()), views::style::CONTEXT_DIALOG_BODY_TEXT,
+      views::style::STYLE_SECONDARY));
+  address->SetHorizontalAlignment(gfx::ALIGN_LEFT);
+  address->SetElideBehavior(gfx::ELIDE_MIDDLE);
+  address->SetMaximumWidthSingleLine(kWidth);
+  address->SetTooltipText(base::UTF8ToUTF16(url.spec()));
+
+  // Current state, then the facts behind it.
+  auto* status = body->AddChildView(std::make_unique<views::Label>(
+      status_, views::style::CONTEXT_DIALOG_BODY_TEXT));
+  status->SetMultiLine(true);
+  status->SetHorizontalAlignment(gfx::ALIGN_LEFT);
+  status->SetMaximumWidth(kWidth - 24);
+  status->SetBorder(views::CreateEmptyBorder(gfx::Insets::VH(8, 12)));
+  status->SetBackground(views::CreateRoundedRectBackground(
+      ui::kColorSubtleEmphasisBackground, 8));
+  status->GetViewAccessibility().SetRole(ax::mojom::Role::kStatus);
+
+  auto* facts = body->AddChildView(std::make_unique<views::View>());
+  auto* table = facts->SetLayoutManager(std::make_unique<views::TableLayout>());
+  table
+      ->AddColumn(views::LayoutAlignment::kStart,
+                  views::LayoutAlignment::kStart,
+                  views::TableLayout::kFixedSize,
+                  views::TableLayout::ColumnSize::kUsePreferred, 0, 0)
+      .AddPaddingColumn(views::TableLayout::kFixedSize, 16)
+      .AddColumn(views::LayoutAlignment::kStretch,
+                 views::LayoutAlignment::kStart, 1.0f,
+                 views::TableLayout::ColumnSize::kUsePreferred, 0, 0);
+  const auto fact = [&](int name, std::u16string value) {
+    table->AddRows(1, views::TableLayout::kFixedSize);
+    facts->AddChildView(std::make_unique<views::Label>(
+        Text(name), views::style::CONTEXT_DIALOG_BODY_TEXT,
+        views::style::STYLE_SECONDARY));
+    auto* label = facts->AddChildView(std::make_unique<views::Label>(
+        std::move(value), views::style::CONTEXT_DIALOG_BODY_TEXT));
+    label->SetHorizontalAlignment(gfx::ALIGN_LEFT);
+    label->SetElideBehavior(gfx::ELIDE_MIDDLE);
+  };
+  fact(IDS_NEO_MONITOR_WATCHING,
+       Text(selector_.empty()      ? IDS_NEO_MONITOR_SCOPE_OFF
+            : selector_ == "@main" ? IDS_NEO_MONITOR_SCOPE_MAIN
+                                   : IDS_NEO_MONITOR_SCOPE_SECTION));
+  fact(IDS_NEO_MONITOR_LAST_CHECK,
+       last_check_value_.is_null()
+           ? Text(IDS_NEO_MONITOR_NOT_YET)
+           : base::TimeFormatShortDateAndTime(last_check_value_));
+  fact(IDS_NEO_MONITOR_LAST_CHANGE,
+       change_time_value_.is_null()
+           ? Text(IDS_NEO_MONITOR_NOT_YET)
+           : base::TimeFormatShortDateAndTime(change_time_value_));
+  if (!export_folder_.empty()) {
+    fact(IDS_NEO_MONITOR_EXPORT_TO, export_folder_.LossyDisplayName());
+  }
+
+  // The latest difference, as coloured removed/added lines.
+  auto list = std::make_unique<views::View>();
+  list->SetLayoutManager(std::make_unique<views::BoxLayout>(
+      views::BoxLayout::Orientation::kVertical, gfx::Insets(4), 2));
+  const auto rows = BuildPageChangeLines(before_, after_);
+  for (const auto& row : rows) {
+    std::u16string text = base::UTF8ToUTF16(row.text);
+    if (row.kind == PageChangeLine::Kind::kGap) {
+      text = l10n_util::GetPluralStringFUTF16(IDS_NEO_MONITOR_UNCHANGED_LINES,
+                                              static_cast<int>(row.hidden));
+    } else if (row.kind == PageChangeLine::Kind::kTruncated) {
+      text = Text(IDS_NEO_MONITOR_MORE_CHANGES);
+    }
+    list->AddChildView(
+        std::make_unique<ChangeRow>(row.kind, std::move(text), kWidth - 10));
+  }
+  if (rows.empty()) {
+    auto* empty = list->AddChildView(std::make_unique<views::Label>(
+        Text(has_history() ? IDS_NEO_MONITOR_NO_CHANGES
+                           : IDS_NEO_MONITOR_NO_BASELINE),
+        views::style::CONTEXT_DIALOG_BODY_TEXT, views::style::STYLE_SECONDARY));
+    empty->SetMultiLine(true);
+    empty->SetMaximumWidth(kWidth - 40);
+    empty->SetBorder(views::CreateEmptyBorder(gfx::Insets::VH(24, 16)));
+  }
+  auto* scroll = body->AddChildView(std::make_unique<views::ScrollView>());
+  scroll->SetHorizontalScrollBarMode(
+      views::ScrollView::ScrollBarMode::kDisabled);
+  scroll->ClipHeightTo(0, 340);
+  scroll->SetBorder(views::CreateRoundedRectBorder(1, 8, ui::kColorSeparator));
+  scroll->SetContents(std::move(list));
+  scroll->GetViewAccessibility().SetName(Text(IDS_NEO_MONITOR_TITLE));
+
+  auto* help = body->AddChildView(std::make_unique<views::Label>(
+      Text(IDS_NEO_MONITOR_HELP), views::style::CONTEXT_DIALOG_BODY_TEXT,
+      views::style::STYLE_SECONDARY));
+  help->SetMultiLine(true);
+  help->SetHorizontalAlignment(gfx::ALIGN_LEFT);
+  help->SetMaximumWidth(kWidth);
+
+  if (!selector_.empty()) {
+    auto stop = std::make_unique<views::MdTextButton>(
+        views::Button::PressedCallback(), Text(IDS_NEO_MONITOR_STOP));
+    stop->SetCallback(base::BindRepeating(
+        [](base::WeakPtr<PageChangeMonitor> self, views::Button* button) {
+          if (self) {
+            self->StopMonitoring();
+          }
+          button->GetWidget()->Close();
+        },
+        weak_factory_.GetWeakPtr(), stop.get()));
+    dialog->SetExtraView(std::move(stop));
+  }
+  dialog->SetContentsView(std::move(body));
+  views::DialogDelegate::CreateDialogWidget(
+      std::move(dialog), web_contents()->GetTopLevelNativeWindow(),
+      gfx::NativeView())
+      ->Show();
+  has_change_ = false;
+  SetAttention(false);
+}
