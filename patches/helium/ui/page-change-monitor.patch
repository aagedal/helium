+// Copyright 2026 The Helium Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+#ifndef CHROME_BROWSER_UI_TABS_PAGE_CHANGE_MONITOR_DIFF_H_
+#define CHROME_BROWSER_UI_TABS_PAGE_CHANGE_MONITOR_DIFF_H_
+
+#include <algorithm>
+#include <string>
+#include <string_view>
+#include <utility>
+#include <vector>
+
+namespace tabs {
+// Linear, bounded review-only diff. Expand the changed span to complete text
+// lines so shared word endings cannot turn Wednesday/Thursday into Wedne/Thur.
+inline std::pair<std::string, std::string> BuildPageChangeDiff(
+    std::string_view before,
+    std::string_view after) {
+  if (before == after) {
+    return {};
+  }
+  const auto lines = [](std::string_view text) {
+    std::vector<std::string_view> result;
+    if (text.empty()) {
+      return result;
+    }
+    size_t start = 0;
+    while (start <= text.size()) {
+      const auto newline = text.find('\n', start);
+      const auto end =
+          newline == std::string_view::npos ? text.size() : newline;
+      result.push_back(text.substr(start, end - start));
+      if (newline == std::string_view::npos) {
+        break;
+      }
+      start = end + 1;
+    }
+    return result;
+  };
+  const auto old_lines = lines(before), new_lines = lines(after);
+  size_t prefix = 0;
+  while (prefix < old_lines.size() && prefix < new_lines.size() &&
+         old_lines[prefix] == new_lines[prefix]) {
+    ++prefix;
+  }
+  size_t suffix = 0;
+  while (suffix < old_lines.size() - prefix &&
+         suffix < new_lines.size() - prefix &&
+         old_lines[old_lines.size() - 1 - suffix] ==
+             new_lines[new_lines.size() - 1 - suffix]) {
+    ++suffix;
+  }
+  const auto excerpt = [prefix, suffix](std::string_view text,
+                                        const auto& parts) {
+    if (parts.size() == prefix + suffix) {
+      return std::string();
+    }
+    const size_t start = parts[prefix].data() - text.data();
+    const auto last = parts[parts.size() - 1 - suffix];
+    size_t end =
+        std::min(static_cast<size_t>(last.data() - text.data()) + last.size(),
+                 start + 16000);
+    // Do not cut the UTF-8 sequence at the byte budget.
+    while (end > start && end < text.size() &&
+           (static_cast<unsigned char>(text[end]) & 0xc0) == 0x80) {
+      --end;
+    }
+    return std::string(text.substr(start, end - start));
+  };
+  return {excerpt(before, old_lines), excerpt(after, new_lines)};
+}
+}  // namespace tabs
+#endif  // CHROME_BROWSER_UI_TABS_PAGE_CHANGE_MONITOR_DIFF_H_
