+
+void PageChangeMonitor::ExportChange() {
+  auto* settings = PaneSettings::GetOrCreate(web_contents());
+  if ((!settings->monitor_screenshot() && !settings->monitor_pdf()) ||
+      exports_pending_) {
+    return;
+  }
+  if (export_folder_.empty()) {
+    status_ = Text(IDS_NEO_MONITOR_NEEDS_FOLDER);
+    return;
+  }
+  if (g_active_monitor_exports >= 1) {
+    status_ = Text(IDS_NEO_MONITOR_EXPORT_BUSY);
+    return;
+  }
+  ++g_active_monitor_exports;
+  export_title_ = web_contents()->GetTitle();
+  export_url_ = web_contents()->GetLastCommittedURL();
+  export_generation_ = generation_;
+  export_failed_ = false;
+  export_stem_ = export_folder_.Append(base::FilePath::FromUTF8Unsafe(
+      sharing_hub::ScreenshotFilenameStem(watched_url_, export_title_,
+                                          base::Time::Now()) +
+      "_" + base::Uuid::GenerateRandomV4().AsLowercaseString()));
+  const bool screenshot = settings->monitor_screenshot();
+  const bool pdf = settings->monitor_pdf();
+  exports_pending_ = static_cast<int>(screenshot) + static_cast<int>(pdf);
+  UpdateBlocked();
+  export_timeout_.Start(
+      FROM_HERE, base::Seconds(30),
+      base::BindOnce(&PageChangeMonitor::ExportTimedOut,
+                     weak_factory_.GetWeakPtr(), generation_));
+  if (screenshot) {
+    auto* view = web_contents()->GetRenderWidgetHostView();
+    if (!sharing_hub::DesktopScreenshotsFeatureEnabled(
+            web_contents()->GetBrowserContext()) ||
+        !view || !view->IsSurfaceAvailableForCopy() ||
+        web_contents()->GetVisibility() != content::Visibility::VISIBLE) {
+      // A hidden tab can have stale compositor pixels. Never save them as new
+      // evidence.
+      ExportFinished(generation_, false);
+    } else {
+      auto size = view->GetViewBounds().size();
+      const double scale = std::min(
+          1.0, std::sqrt(8000000.0 /
+                         std::max(1.0, static_cast<double>(size.width()) *
+                                           size.height())));
+      size = gfx::Size(std::max(1, static_cast<int>(size.width() * scale)),
+                       std::max(1, static_cast<int>(size.height() * scale)));
+      screenshot_started_at_ = base::TimeFormatAsIso8601(base::Time::Now());
+      view->CopyFromSurface(gfx::Rect(), size, base::Seconds(5),
+                            base::BindPostTaskToCurrentDefault(base::BindOnce(
+                                &PageChangeMonitor::ScreenshotReady,
+                                weak_factory_.GetWeakPtr(), generation_)));
+    }
+  }
+  if (pdf) {
+#if BUILDFLAG(ENABLE_PRINTING)
+#if BUILDFLAG(ENABLE_PRINT_PREVIEW)
+    auto* manager = printing::PrintViewManager::FromWebContents(web_contents());
+#else
+    auto* manager =
+        printing::PrintViewManagerBasic::FromWebContents(web_contents());
+#endif
+    auto* prefs =
+        Profile::FromBrowserContext(web_contents()->GetBrowserContext())
+            ->GetPrefs();
+    auto params = print_to_pdf::GetPrintPagesParams(
+        export_url_, false, true, true, 1.0, 8.27, 11.69, 0.4, 0.4, 0.4, 0.4,
+        std::nullopt, std::nullopt, false, true, false);
+    if (!manager || !prefs->GetBoolean(prefs::kPrintingEnabled) ||
+        !std::holds_alternative<printing::mojom::PrintPagesParamsPtr>(params)) {
+      ExportFinished(generation_, false);
+    } else {
+      manager->PrintToPdf(
+          web_contents()->GetPrimaryMainFrame(), "",
+          std::move(std::get<printing::mojom::PrintPagesParamsPtr>(params)),
+          base::BindOnce(
+              [](base::WeakPtr<PageChangeMonitor> self, int generation,
+                 print_to_pdf::PdfPrintResult result,
+                 scoped_refptr<base::RefCountedMemory> bytes) {
+                if (!self) {
+                  return;
+                }
+                if (result != print_to_pdf::PdfPrintResult::kPrintSuccess ||
+                    !bytes || bytes->size() > 32 * 1024 * 1024) {
+                  self->ExportFinished(generation, false);
+                } else {
+                  self->SaveExport(
+                      generation, "pdf",
+                      std::string(reinterpret_cast<const char*>(bytes->data()),
+                                  bytes->size()));
+                }
+              },
+              weak_factory_.GetWeakPtr(), generation_));
+    }
+#else
+    ExportFinished(generation_, false);
+#endif
+  }
+}
+
+void PageChangeMonitor::ScreenshotReady(
+    int generation,
+    const content::CopyFromSurfaceResult& result) {
+  if (generation != generation_ || !result.has_value()) {
+    ExportFinished(generation, false);
+    return;
+  }
+  base::DictValue automatic;
+  automatic.Set("page_url", export_url_.spec());
+  automatic.Set("browser", "Helium Neo / Chromium " +
+                               std::string(version_info::GetVersionNumber()));
+  automatic.Set("page_title", base::UTF16ToUTF8(export_title_));
+  automatic.Set("capture_started_at_utc", screenshot_started_at_);
+  automatic.Set("capture_completed_at_utc",
+                base::TimeFormatAsIso8601(base::Time::Now()));
+  automatic.Set("capture_trigger", "text_change_monitor");
+  automatic.Set("monitor_selector", selector_);
+  automatic.Set("screenshot_scope", "visible_pane_sdr_at_most_8_megapixels");
+  base::ThreadPool::PostTaskAndReplyWithResult(
+      FROM_HERE, {base::MayBlock(), base::TaskPriority::BEST_EFFORT},
+      base::BindOnce(
+          [](SkBitmap bitmap, base::DictValue automatic) {
+            return sharing_hub::CreateScreenshotExport(
+                bitmap, std::move(automatic), base::DictValue(),
+                sharing_hub::ScreenshotFormat::kPng, false, false);
+          },
+          result->bitmap, std::move(automatic)),
+      base::BindOnce(
+          [](base::WeakPtr<PageChangeMonitor> self, int generation,
+             sharing_hub::ScreenshotExport output) {
+            if (self) {
+              self->SaveExport(generation, "png", std::move(output.bytes));
+            }
+          },
+          weak_factory_.GetWeakPtr(), generation));
+}
+
+void PageChangeMonitor::SaveExport(int generation,
+                                   std::string extension,
+                                   std::string bytes) {
+  if (generation != generation_ || bytes.empty()) {
+    ExportFinished(generation, false);
+    return;
+  }
+  base::DictValue record;
+  record.Set("schema_version", 1);
+  record.Set("page_url", export_url_.spec());
+  record.Set("page_title", base::UTF16ToUTF8(export_title_));
+  record.Set("monitor_selector", selector_);
+  record.Set("change_observed_at_utc", change_time_);
+  record.Set("export_completed_at_utc",
+             base::TimeFormatAsIso8601(base::Time::Now()));
+  record.Set("previous_text", before_);
+  record.Set("current_text", after_);
+  record.Set("export_type", extension);
+  record.Set("limitations",
+             "Text change observed using the computer clock; not proof of "
+             "authenticity. "
+             "Export follows detection and may reflect later page updates. PNG "
+             "captures only the visible pane; "
+             "PDF uses print layout and may omit interactive content. No "
+             "original publication time is inferred.");
+  const auto path = export_stem_.AddExtensionASCII(extension);
+  base::ThreadPool::PostTaskAndReplyWithResult(
+      FROM_HERE, {base::MayBlock(), base::TaskPriority::BEST_EFFORT},
+      base::BindOnce(&WriteExport, path, std::move(bytes), std::move(record)),
+      base::BindOnce(&PageChangeMonitor::ExportFinished,
+                     weak_factory_.GetWeakPtr(), generation));
+}
+
+void PageChangeMonitor::ExportTimedOut(int generation) {
+  if (generation != export_generation_ || exports_pending_ <= 0) {
+    return;
+  }
+  // Stop adding work if a renderer or print job fails to answer. Existing
+  // callbacks are generation-checked and cannot save a later page as this one.
+  ++generation_;
+  exports_pending_ = 0;
+  --g_active_monitor_exports;
+  PaneSettings::GetOrCreate(web_contents())->SetMonitorExports(false, false);
+  status_ = Text(IDS_NEO_MONITOR_EXPORT_TIMEOUT);
+  UpdateBlocked();
+}
+
+void PageChangeMonitor::ExportFinished(int generation, bool success) {
+  if (generation != export_generation_ || exports_pending_ <= 0) {
+    return;
+  }
+  --exports_pending_;
+  export_failed_ |= !success || generation != generation_;
+  if (!exports_pending_) {
+    export_timeout_.Stop();
+    --g_active_monitor_exports;
+    status_ = Text(export_failed_ ? IDS_NEO_MONITOR_EXPORT_FAILED
+                                  : IDS_NEO_MONITOR_EXPORTED);
+    UpdateBlocked();
+    if (baseline_.empty() && !selector_.empty()) {
+      ScheduleScan();
+    }
+  }
+}
