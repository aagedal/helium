+#include "chrome/browser/ui/tabs/image_match_finder.h"
+
+#include <algorithm>
+#include <memory>
+#include <string>
+#include <utility>
+#include <vector>
+
+#include "base/functional/bind.h"
+#include "base/functional/callback.h"
+#include "base/functional/callback_helpers.h"
+#include "base/json/json_writer.h"
+#include "base/memory/weak_ptr.h"
+#include "base/strings/string_number_conversions.h"
+#include "base/strings/utf_string_conversions.h"
+#include "base/supports_user_data.h"
+#include "base/task/sequenced_task_runner.h"
+#include "base/task/thread_pool.h"
+#include "base/time/time.h"
+#include "base/timer/timer.h"
+#include "base/values.h"
+#include "chrome/browser/ui/browser_window/public/browser_window_interface.h"
+#include "chrome/browser/ui/tabs/image_match_compare.h"
+#include "chrome/browser/ui/tabs/image_match_script.h"
+#include "chrome/browser/ui/tabs/tab_strip_model.h"
+#include "chrome/common/chrome_isolated_world_ids.h"
+#include "chrome/common/chrome_render_frame.mojom.h"
+#include "chrome/grit/generated_resources.h"
+#include "components/tabs/public/tab_interface.h"
+#include "content/public/browser/browser_context.h"
+#include "content/public/browser/render_frame_host.h"
+#include "content/public/browser/web_contents.h"
+#include "mojo/public/cpp/bindings/associated_remote.h"
+#include "third_party/blink/public/common/associated_interfaces/associated_interface_provider.h"
+#include "ui/base/l10n/l10n_util.h"
+#include "url/gurl.h"
+
+namespace tabs {
+namespace {
+
+constexpr size_t kMaxShownMatches = 20;
+// Lazy images this far below the current position are loaded first. Pages
+// are never scrolled, so infinite scroll pages do not grow.
+constexpr int kLoadScreens = 20;
+constexpr base::TimeDelta kLoadWait = base::Seconds(3);
+constexpr base::TimeDelta kLoadPollInterval = base::Milliseconds(200);
+// Frozen background tabs may never answer.
+constexpr base::TimeDelta kScanTimeout = kLoadWait + base::Seconds(4);
+
+constexpr char kChosenImageKey[] = "helium_neo_image_match_query";
+
+// Kept on the profile, so a picture chosen in an incognito window is never
+// searched for in a regular one.
+struct ChosenImage : public base::SupportsUserData::Data {
+  explicit ChosenImage(GrayImage value) : thumbnail(std::move(value)) {}
+  GrayImage thumbnail;
+};
+
+struct Match {
+  uint32_t index = 0;
+  float score = 0;
+};
+
+GrayImage ToGrayImage(chrome::mojom::ImageThumbnail& thumbnail) {
+  return {thumbnail.width, thumbnail.height, std::move(thumbnail.luma)};
+}
+
+// Runs on the thread pool: cropped matches need a search per image.
+std::vector<Match> FindMatches(
+    std::shared_ptr<const ImageMatcher> matcher,
+    std::vector<std::pair<uint32_t, GrayImage>> images) {
+  std::vector<Match> matches;
+  for (const auto& [index, image] : images) {
+    const float score = matcher->Compare(image);
+    if (score >= ImageMatcher::kMatchScore) {
+      matches.push_back({index, score});
+    }
+  }
+  // Best first; page order among equally good matches.
+  std::stable_sort(
+      matches.begin(), matches.end(),
+      [](const Match& a, const Match& b) { return a.score > b.score; });
+  if (matches.size() > kMaxShownMatches) {
+    matches.resize(kMaxShownMatches);
+  }
+  return matches;
+}
+
+struct PageResult {
+  base::WeakPtr<content::WebContents> contents;
+  std::vector<Match> matches;
+  uint32_t unloaded_count = 0;
+  bool loading = false;
+  bool polling = false;
+  bool answered = false;
+};
+
+std::string Text(int id) {
+  return l10n_util::GetStringUTF8(id);
+}
+
+bool CanScan(content::WebContents* contents) {
+  if (!contents || contents->WasDiscarded() || contents->IsCrashed()) {
+    return false;
+  }
+  content::RenderFrameHost* frame = contents->GetPrimaryMainFrame();
+  const GURL& url = contents->GetLastCommittedURL();
+  return frame && frame->IsRenderFrameLive() &&
+         (url.SchemeIsHTTPOrHTTPS() || url.SchemeIsFile());
+}
+
+// Outlines |matches| in |contents|, or shows |message| when there are none.
+void ShowOnPage(content::WebContents* contents,
+                const std::vector<Match>& matches,
+                const std::string& message,
+                bool some_unloaded) {
+  if (!CanScan(contents)) {
+    return;
+  }
+  base::ListValue shown;
+  for (const Match& match : matches) {
+    shown.Append(base::DictValue()
+                     .Set("index", static_cast<int>(match.index))
+                     .Set("exact", match.score >= ImageMatcher::kSameScore));
+  }
+  base::DictValue strings;
+  strings.Set("counter", Text(IDS_NEO_IMAGE_MATCH_COUNTER));
+  strings.Set("exact", Text(IDS_NEO_IMAGE_MATCH_EXACT));
+  strings.Set("similar", Text(IDS_NEO_IMAGE_MATCH_SIMILAR));
+  strings.Set("hidden", Text(IDS_NEO_IMAGE_MATCH_HIDDEN));
+  strings.Set("previous", Text(IDS_NEO_IMAGE_MATCH_PREVIOUS));
+  strings.Set("next", Text(IDS_NEO_IMAGE_MATCH_NEXT));
+  strings.Set("close", Text(IDS_NEO_IMAGE_MATCH_CLOSE));
+  base::DictValue argument;
+  argument.Set("matches", std::move(shown));
+  argument.Set("message", message);
+  argument.Set("hint", some_unloaded ? Text(IDS_NEO_IMAGE_MATCH_UNLOADED)
+                                     : std::string());
+  argument.Set("strings", std::move(strings));
+  std::string json;
+  base::JSONWriter::Write(argument, &json);
+  contents->GetPrimaryMainFrame()->ExecuteJavaScriptInIsolatedWorld(
+      base::UTF8ToUTF16(std::string(kImageMatchScript) + "(" + json + ")"),
+      base::DoNothing(), ISOLATED_WORLD_ID_CHROME_INTERNAL);
+  // Escape must reach the page rather than the menu or tab strip.
+  contents->Focus();
+}
+
+// Loads nearby lazy images in each page's main frame, then asks for its image
+// thumbnails and compares them with the query. Deletes itself once every
+// page answered or the time ran out.
+class Scan {
+ public:
+  using Done = base::OnceCallback<void(std::vector<PageResult>)>;
+
+  static void Start(std::shared_ptr<const ImageMatcher> matcher,
+                    const std::vector<content::WebContents*>& pages,
+                    Done done) {
+    (new Scan(std::move(matcher), std::move(done)))->Request(pages);
+  }
+
+  Scan(const Scan&) = delete;
+  Scan& operator=(const Scan&) = delete;
+  ~Scan() = default;
+
+ private:
+  Scan(std::shared_ptr<const ImageMatcher> matcher, Done done)
+      : matcher_(std::move(matcher)), done_(std::move(done)) {}
+
+  void Request(const std::vector<content::WebContents*>& pages) {
+    results_.resize(pages.size());
+    remotes_.resize(pages.size());
+    pending_ = pages.size();
+    load_deadline_ = base::TimeTicks::Now() + kLoadWait;
+    for (size_t i = 0; i < pages.size(); ++i) {
+      results_[i].contents = pages[i]->GetWeakPtr();
+      results_[i].loading = true;
+      results_[i].polling = true;
+      pages[i]->GetPrimaryMainFrame()->ExecuteJavaScriptInIsolatedWorld(
+          base::UTF8ToUTF16(std::string(kImageMatchLoadScript) + "(" +
+                            base::NumberToString(kLoadScreens) + ")"),
+          base::BindOnce(&Scan::OnLoadState, weak_factory_.GetWeakPtr(), i),
+          ISOLATED_WORLD_ID_CHROME_INTERNAL);
+    }
+    if (!pending_) {
+      Finish();
+      return;
+    }
+    timeout_.Start(FROM_HERE, kScanTimeout,
+                   base::BindOnce(&Scan::Finish, base::Unretained(this)));
+    poll_timer_.Start(
+        FROM_HERE, kLoadPollInterval,
+        base::BindRepeating(&Scan::PollLoads, base::Unretained(this)));
+  }
+
+  // |state| is the number of images still loading in |page|.
+  void OnLoadState(size_t page, base::Value state) {
+    PageResult& result = results_[page];
+    result.polling = false;
+    if (!result.loading) {
+      return;
+    }
+    if (state.GetIfInt().value_or(0) <= 0) {
+      RequestThumbnails(page);
+    }
+  }
+
+  void PollLoads() {
+    const bool expired = base::TimeTicks::Now() >= load_deadline_;
+    bool loading = false;
+    for (size_t i = 0; i < results_.size(); ++i) {
+      PageResult& result = results_[i];
+      if (!result.loading) {
+        continue;
+      }
+      if (!result.contents) {
+        result.loading = false;
+        Answered(i);
+        continue;
+      }
+      // Compare whatever has loaded by now.
+      if (expired) {
+        RequestThumbnails(i);
+        continue;
+      }
+      loading = true;
+      if (!result.polling) {
+        result.polling = true;
+        result.contents->GetPrimaryMainFrame()
+            ->ExecuteJavaScriptInIsolatedWorld(
+                base::UTF8ToUTF16(std::string(kImageMatchLoadPollScript)),
+                base::BindOnce(&Scan::OnLoadState, weak_factory_.GetWeakPtr(),
+                               i),
+                ISOLATED_WORLD_ID_CHROME_INTERNAL);
+      }
+    }
+    if (!loading) {
+      poll_timer_.Stop();
+    }
+  }
+
+  void RequestThumbnails(size_t page) {
+    PageResult& result = results_[page];
+    result.loading = false;
+    if (!result.contents) {
+      Answered(page);
+      return;
+    }
+    result.contents->GetPrimaryMainFrame()
+        ->GetRemoteAssociatedInterfaces()
+        ->GetInterface(&remotes_[page]);
+    remotes_[page].set_disconnect_handler(base::BindOnce(
+        &Scan::Answered, weak_factory_.GetWeakPtr(), page));
+    remotes_[page]->RequestImageThumbnails(base::BindOnce(
+        &Scan::OnThumbnails, weak_factory_.GetWeakPtr(), page));
+  }
+
+  void OnThumbnails(size_t page,
+                    std::vector<chrome::mojom::ImageThumbnailPtr> thumbnails,
+                    uint32_t unloaded_count) {
+    results_[page].unloaded_count = unloaded_count;
+    std::vector<std::pair<uint32_t, GrayImage>> images;
+    images.reserve(thumbnails.size());
+    for (auto& thumbnail : thumbnails) {
+      images.emplace_back(thumbnail->index, ToGrayImage(*thumbnail));
+    }
+    base::ThreadPool::PostTaskAndReplyWithResult(
+        FROM_HERE, {base::TaskPriority::USER_VISIBLE},
+        base::BindOnce(&FindMatches, matcher_, std::move(images)),
+        base::BindOnce(&Scan::OnMatches, weak_factory_.GetWeakPtr(), page));
+  }
+
+  void OnMatches(size_t page, std::vector<Match> matches) {
+    results_[page].matches = std::move(matches);
+    Answered(page);
+  }
+
+  void Answered(size_t page) {
+    if (finished_ || results_[page].answered) {
+      return;
+    }
+    results_[page].answered = true;
+    if (--pending_ == 0) {
+      Finish();
+    }
+  }
+
+  void Finish() {
+    if (finished_) {
+      return;
+    }
+    finished_ = true;
+    timeout_.Stop();
+    poll_timer_.Stop();
+    weak_factory_.InvalidateWeakPtrs();
+    std::move(done_).Run(std::move(results_));
+    // A reply callback may still be running on one of |remotes_|.
+    base::SequencedTaskRunner::GetCurrentDefault()->DeleteSoon(FROM_HERE,
+                                                               this);
+  }
+
+  const std::shared_ptr<const ImageMatcher> matcher_;
+  Done done_;
+  std::vector<PageResult> results_;
+  std::vector<mojo::AssociatedRemote<chrome::mojom::ChromeRenderFrame>>
+      remotes_;
+  size_t pending_ = 0;
+  bool finished_ = false;
+  base::TimeTicks load_deadline_;
+  base::OneShotTimer timeout_;
+  base::RepeatingTimer poll_timer_;
+  base::WeakPtrFactory<Scan> weak_factory_{this};
+};
+
+void ShowBestTab(base::WeakPtr<content::WebContents> source,
+                 std::vector<PageResult> results) {
+  const PageResult* best = nullptr;
+  for (const PageResult& result : results) {
+    if (result.contents && !result.matches.empty() &&
+        (!best || result.matches[0].score > best->matches[0].score)) {
+      best = &result;
+    }
+  }
+  if (!best) {
+    const bool some_unloaded = std::any_of(
+        results.begin(), results.end(),
+        [](const PageResult& result) { return result.unloaded_count > 0; });
+    if (source) {
+      ShowOnPage(source.get(), {},
+                 Text(results.empty() ? IDS_NEO_IMAGE_MATCH_NO_TABS
+                                      : IDS_NEO_IMAGE_MATCH_NONE_IN_TABS),
+                 some_unloaded);
+    }
+    return;
+  }
+  content::WebContents* target = best->contents.get();
+  if (TabInterface* tab = TabInterface::MaybeGetFromContents(target)) {
+    if (auto* window = tab->GetBrowserWindowInterface()) {
+      TabStripModel* tab_strip = window->GetTabStripModel();
+      const int index = tab_strip->GetIndexOfWebContents(target);
+      if (index != TabStripModel::kNoTab) {
+        tab_strip->ActivateTabAt(index);
+      }
+    }
+  }
+  ShowOnPage(target, best->matches, std::string(), best->unloaded_count > 0);
+}
+
+void ShowOnScannedPage(std::vector<PageResult> results) {
+  if (results.empty() || !results[0].contents) {
+    return;
+  }
+  const PageResult& result = results[0];
+  ShowOnPage(result.contents.get(), result.matches,
+             result.matches.empty() ? Text(IDS_NEO_IMAGE_MATCH_NONE_ON_PAGE)
+                                    : std::string(),
+             result.unloaded_count > 0);
+}
+
+void OnContextThumbnail(
+    mojo::AssociatedRemote<chrome::mojom::ChromeRenderFrame> remote,
+    base::WeakPtr<content::WebContents> source,
+    chrome::mojom::ImageThumbnailPtr thumbnail) {
+  if (!source) {
+    return;
+  }
+  GrayImage query = thumbnail ? ToGrayImage(*thumbnail) : GrayImage();
+  auto matcher = std::make_shared<const ImageMatcher>(query);
+  if (!matcher->usable()) {
+    ShowOnPage(source.get(), {}, Text(IDS_NEO_IMAGE_MATCH_TOO_PLAIN), false);
+    return;
+  }
+  source->GetBrowserContext()->SetUserData(
+      kChosenImageKey, std::make_unique<ChosenImage>(std::move(query)));
+  std::vector<content::WebContents*> pages;
+  TabInterface* tab = TabInterface::MaybeGetFromContents(source.get());
+  BrowserWindowInterface* window =
+      tab ? tab->GetBrowserWindowInterface() : nullptr;
+  if (TabStripModel* tab_strip = window ? window->GetTabStripModel() : nullptr) {
+    for (int i = 0; i < tab_strip->count(); ++i) {
+      content::WebContents* contents = tab_strip->GetWebContentsAt(i);
+      if (contents != source.get() && CanScan(contents)) {
+        pages.push_back(contents);
+      }
+    }
+  }
+  Scan::Start(std::move(matcher), pages,
+              base::BindOnce(&ShowBestTab, source));
+}
+
+}  // namespace
+
+void FindContextImageInOtherTabs(content::RenderFrameHost* frame) {
+  content::WebContents* source =
+      content::WebContents::FromRenderFrameHost(frame);
+  if (!source) {
+    return;
+  }
+  mojo::AssociatedRemote<chrome::mojom::ChromeRenderFrame> remote;
+  frame->GetRemoteAssociatedInterfaces()->GetInterface(&remote);
+  auto* proxy = remote.get();
+  // The remote rides along in the callback so it stays open for the reply.
+  proxy->RequestImageThumbnailForContextNode(
+      base::BindOnce(&OnContextThumbnail, std::move(remote),
+                     source->GetWeakPtr()));
+}
+
+bool HasChosenImage(content::BrowserContext* context) {
+  return context && context->GetUserData(kChosenImageKey);
+}
+
+void FindChosenImageOnPage(content::WebContents* contents) {
+  if (!CanScan(contents)) {
+    return;
+  }
+  const auto* chosen = static_cast<ChosenImage*>(
+      contents->GetBrowserContext()->GetUserData(kChosenImageKey));
+  if (!chosen) {
+    return;
+  }
+  Scan::Start(std::make_shared<const ImageMatcher>(chosen->thumbnail),
+              {contents}, base::BindOnce(&ShowOnScannedPage));
+}
