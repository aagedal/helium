+namespace {
+
+// Helium Neo: thumbnails for finding a picture by appearance. Tiny images
+// such as icons would only add false matches.
+constexpr int kThumbnailMinSize = 24;
+constexpr int kThumbnailSide = 64;
+constexpr size_t kMaxThumbnailedImages = 3000;
+
+chrome::mojom::ImageThumbnailPtr ThumbnailImage(const SkBitmap& image,
+                                                uint32_t index) {
+  if (image.drawsNothing() || image.width() < kThumbnailMinSize ||
+      image.height() < kThumbnailMinSize) {
+    return nullptr;
+  }
+  SkBitmap source = image;
+  if (source.colorType() != kN32_SkColorType) {
+    if (!source.tryAllocPixels(image.info().makeColorType(kN32_SkColorType)) ||
+        !image.readPixels(source.pixmap())) {
+      return nullptr;
+    }
+  }
+  const double scale = std::min(
+      1.0, static_cast<double>(kThumbnailSide) /
+               std::max(source.width(), source.height()));
+  const int width = std::max(1, static_cast<int>(source.width() * scale + 0.5));
+  const int height =
+      std::max(1, static_cast<int>(source.height() * scale + 0.5));
+  SkBitmap thumbnail =
+      (width == source.width() && height == source.height())
+          ? source
+          : skia::ImageOperations::Resize(
+                source, skia::ImageOperations::RESIZE_BOX, width, height);
+  if (thumbnail.drawsNothing()) {
+    return nullptr;
+  }
+  std::vector<uint8_t> luma(static_cast<size_t>(width) * height);
+  for (int y = 0; y < height; ++y) {
+    for (int x = 0; x < width; ++x) {
+      // Transparent areas count as a white page background.
+      const SkColor pixel = thumbnail.getColor(x, y);
+      const int alpha = SkColorGetA(pixel);
+      const auto over_white = [alpha](int channel) {
+        return (channel * alpha + 255 * (255 - alpha)) / 255;
+      };
+      luma[static_cast<size_t>(y) * width + x] = static_cast<uint8_t>(
+          (299 * over_white(SkColorGetR(pixel)) +
+           587 * over_white(SkColorGetG(pixel)) +
+           114 * over_white(SkColorGetB(pixel)) + 500) /
+          1000);
+    }
+  }
+  return chrome::mojom::ImageThumbnail::New(index, width, height,
+                                            std::move(luma));
+}
+
+}  // namespace
+
+void ChromeRenderFrameObserver::RequestImageThumbnailForContextNode(
+    RequestImageThumbnailForContextNodeCallback callback) {
+  WebNode context_node = render_frame()->GetWebFrame()->ContextMenuImageNode();
+  if (context_node.IsNull() || !context_node.IsElementNode()) {
+    std::move(callback).Run(nullptr);
+    return;
+  }
+  std::move(callback).Run(
+      ThumbnailImage(context_node.To<WebElement>().ImageContents(), 0));
+}
+
+void ChromeRenderFrameObserver::RequestImageThumbnails(
+    RequestImageThumbnailsCallback callback) {
+  std::vector<chrome::mojom::ImageThumbnailPtr> thumbnails;
+  const blink::WebDocument doc = render_frame()->GetWebFrame()->GetDocument();
+  if (doc.IsNull()) {
+    std::move(callback).Run(std::move(thumbnails), 0);
+    return;
+  }
+  // Same elements and order as document.getElementsByTagName('img'), so the
+  // page overlay can find each match by its index.
+  blink::WebElementCollection images = doc.GetElementsByHTMLTagName("img");
+  uint32_t index = 0;
+  uint32_t unloaded_count = 0;
+  for (WebElement image = images.FirstItem(); !image.IsNull();
+       image = images.NextItem(), ++index) {
+    if (index >= kMaxThumbnailedImages) {
+      ++unloaded_count;
+      continue;
+    }
+    const SkBitmap contents = image.ImageContents();
+    if (contents.isNull()) {
+      ++unloaded_count;
+    } else if (auto thumbnail = ThumbnailImage(contents, index)) {
+      thumbnails.push_back(std::move(thumbnail));
+    }
+  }
+  std::move(callback).Run(std::move(thumbnails), unloaded_count);
+}
