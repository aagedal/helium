+
+void FindBarView::ShowImageMenu() {
+  image_menu_model_ = std::make_unique<ui::SimpleMenuModel>(this);
+  image_menu_model_->AddItemWithStringId(kPasteImage,
+                                         IDS_NEO_IMAGE_MATCH_PASTE);
+  image_menu_model_->AddItemWithStringId(kChooseImageFile,
+                                         IDS_NEO_IMAGE_MATCH_CHOOSE_FILE);
+  if (content::WebContents* contents = GetWebContents();
+      contents && tabs::HasChosenImage(contents->GetBrowserContext())) {
+    image_menu_model_->AddItemWithStringId(kUseChosenImage,
+                                           IDS_NEO_IMAGE_MATCH_USE_CHOSEN);
+  }
+  image_menu_runner_ = std::make_unique<views::MenuRunner>(
+      image_menu_model_.get(), views::MenuRunner::HAS_MNEMONICS);
+  image_menu_runner_->RunMenuAt(
+      GetWidget(), nullptr, image_button_->GetAnchorBoundsInScreen(),
+      views::MenuAnchorPosition::kTopRight, ui::mojom::MenuSourceType::kNone);
+}
+
+void FindBarView::ExecuteCommand(int command_id, int event_flags) {
+  content::WebContents* contents = GetWebContents();
+  if (!contents) {
+    return;
+  }
+  switch (command_id) {
+    case kPasteImage:
+      ui::Clipboard::GetForCurrentThread()->ReadPng(
+          ui::ClipboardBuffer::kCopyPaste, /*data_dst=*/std::nullopt,
+          base::BindOnce(&FindBarView::OnMenuPastePng,
+                         weak_factory_.GetWeakPtr()));
+      break;
+    case kChooseImageFile: {
+      if (select_file_dialog_) {
+        select_file_dialog_->ListenerDestroyed();
+      }
+      select_file_dialog_ = ui::SelectFileDialog::Create(
+          this, std::make_unique<ChromeSelectFilePolicy>(contents));
+      ui::SelectFileDialog::FileTypeInfo types;
+      types.extensions = {{FILE_PATH_LITERAL("png"), FILE_PATH_LITERAL("jpg"),
+                           FILE_PATH_LITERAL("jpeg"), FILE_PATH_LITERAL("webp"),
+                           FILE_PATH_LITERAL("gif"), FILE_PATH_LITERAL("bmp"),
+                           FILE_PATH_LITERAL("avif"), FILE_PATH_LITERAL("ico")}};
+      types.include_all_files = true;
+      select_file_dialog_->SelectFile(
+          ui::SelectFileDialog::SELECT_OPEN_FILE,
+          l10n_util::GetStringUTF16(IDS_NEO_IMAGE_MATCH_FILE_TITLE),
+          base::FilePath(), &types, 1, base::FilePath::StringType(),
+          contents->GetTopLevelNativeWindow());
+      break;
+    }
+    case kUseChosenImage:
+      StartImageSearch();
+      image_preview_->SetImage(ui::ImageModel::FromVectorIcon(
+          kImageIcon, kColorFindBarButtonIcon, kImagePreviewSize));
+      image_preview_->SetVisible(true);
+      tabs::FindChosenImageOnPage(
+          contents, base::BindOnce(&FindBarView::OnImageSearchDone,
+                                   weak_factory_.GetWeakPtr(),
+                                   image_search_generation_));
+      break;
+  }
+}
+
+bool FindBarView::IsCommandIdEnabled(int command_id) const {
+  return GetWebContents() != nullptr;
+}
+
+void FindBarView::FileSelected(const ui::SelectedFileInfo& file, int index) {
+  SearchForImageFile(file.path());
+}
