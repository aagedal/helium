+// Copyright 2026 The Helium Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+#ifndef CHROME_BROWSER_UI_TABS_IMAGE_MATCH_SCRIPT_H_
+#define CHROME_BROWSER_UI_TABS_IMAGE_MATCH_SCRIPT_H_
+
+namespace tabs {
+// Outlines image matches, called as
+// show({matches, message, hint, strings, controls}) in an isolated world.
+// Each match names an index into document.getElementsByTagName('img'). With
+// no matches it only shows |message|. Without |controls| the find bar steps
+// through matches instead of a bar on the page. The outlines ignore pointer
+// input; only the bar is clickable.
+inline constexpr char kImageMatchScript[] = R"JS(
+(({matches, message, hint, strings, controls}) => {
+  globalThis.heliumNeoImageMatch?.close();
+  const images = document.getElementsByTagName('img');
+  const found = matches.map(match => ({...match, image: images[match.index]}))
+      .filter(match => match.image);
+  const host = document.createElement('div');
+  host.style.cssText = 'all:initial;position:fixed;inset:0;z-index:2147483647;pointer-events:none;';
+  const shadow = host.attachShadow({mode: 'closed'});
+  const sheet = new CSSStyleSheet();
+  sheet.replaceSync(`
+    .box { position: fixed; border: 2px solid #1a73e8; border-radius: 4px;
+           background: rgb(26 115 232 / .08); transition: box-shadow .5s, opacity .2s; }
+    .box.other { opacity: .55; border-style: dashed; }
+    .box.current { border-width: 3px; box-shadow: 0 0 0 4px rgb(26 115 232 / .3); }
+    .box.spotlight { box-shadow: 0 0 0 4px rgb(26 115 232 / .3), 0 0 0 100vmax rgb(0 0 0 / .35); }
+    .tag { position: absolute; left: -2px; bottom: 100%; margin-bottom: 4px; white-space: nowrap;
+           padding: 3px 8px; border-radius: 4px; background: #1a73e8; color: white;
+           font: 12px/1.4 system-ui, sans-serif; }
+    .below .tag { bottom: auto; top: 100%; margin: 4px 0 0; }
+    .box:not(.current) .tag { display: none; }
+    .bar { position: fixed; left: 50%; bottom: 24px; transform: translateX(-50%);
+           display: flex; align-items: center; gap: 8px; max-width: min(560px, calc(100vw - 32px));
+           padding: 8px 8px 8px 14px; border-radius: 10px; background: rgb(32 33 36 / .94);
+           color: white; font: 13px/1.4 system-ui, sans-serif; pointer-events: auto;
+           box-shadow: 0 4px 16px rgb(0 0 0 / .3); }
+    .text { display: flex; flex-direction: column; min-width: 0; }
+    .hint { opacity: .75; font-size: 12px; }
+    button { font: inherit; color: inherit; background: rgb(255 255 255 / .16);
+             border: 0; border-radius: 6px; padding: 4px 10px; cursor: pointer; flex: none; }
+    button:hover { background: rgb(255 255 255 / .26); }
+    button:disabled { opacity: .4; cursor: default; }
+  `);
+  shadow.adoptedStyleSheets = [sheet];
+  const element = (tag, className, text) => {
+    const node = document.createElement(tag);
+    if (className) node.className = className;
+    if (text) node.textContent = text;
+    return node;
+  };
+  const boxes = found.map(match => {
+    const box = element('div', 'box other');
+    box.append(element('div', 'tag', match.exact ? strings.exact : strings.similar));
+    shadow.append(box);
+    return box;
+  });
+  const bar = element('div', 'bar');
+  const text = element('div', 'text');
+  const status = element('div', '', message);
+  const note = element('div', 'hint', hint);
+  text.append(status);
+  if (hint) text.append(note);
+  const button = (label, onClick) => {
+    const node = element('button', '', label);
+    node.addEventListener('click', onClick);
+    return node;
+  };
+  let current = 0;
+  const previous = button(strings.previous, () => select(current - 1));
+  const next = button(strings.next, () => select(current + 1));
+  if (found.length > 1) bar.append(text, previous, next);
+  else bar.append(text);
+  bar.append(button(strings.close, () => close()));
+  if (controls) shadow.append(bar);
+
+  const hidden = image => {
+    const rect = image.getBoundingClientRect();
+    return rect.width < 2 || rect.height < 2 || !image.checkVisibility?.({visibilityProperty: true});
+  };
+  const select = index => {
+    if (!found.length) return;
+    current = (index + found.length) % found.length;
+    boxes.forEach((box, i) => {
+      box.classList.toggle('current', i === current);
+      box.classList.toggle('other', i !== current);
+      box.classList.remove('spotlight');
+    });
+    const image = found[current].image;
+    status.textContent = strings.counter.replace('$1', current + 1).replace('$2', found.length) +
+        (hidden(image) ? ' · ' + strings.hidden : '');
+    image.scrollIntoView({block: 'center', inline: 'center', behavior: 'smooth'});
+    // Dim the rest of the page briefly so the match stands out.
+    boxes[current].classList.add('spotlight');
+    clearTimeout(spotlight);
+    spotlight = setTimeout(() => boxes[current]?.classList.remove('spotlight'), 1400);
+  };
+  let spotlight;
+  const place = () => found.forEach((match, i) => {
+    const rect = match.image.getBoundingClientRect();
+    const invisible = rect.width < 2 || rect.height < 2;
+    Object.assign(boxes[i].style, {display: invisible ? 'none' : 'block',
+                                   left: rect.left - 4 + 'px', top: rect.top - 4 + 'px',
+                                   width: rect.width + 8 + 'px', height: rect.height + 8 + 'px'});
+    boxes[i].classList.toggle('below', rect.top < 40);
+  });
+  const onKey = event => {
+    if (controls && event.key === 'Escape') { close(); event.stopPropagation(); event.preventDefault(); }
+  };
+  const close = () => {
+    clearTimeout(spotlight);
+    clearTimeout(expiry);
+    window.removeEventListener('keydown', onKey, true);
+    host.remove();
+    if (globalThis.heliumNeoImageMatch === api) delete globalThis.heliumNeoImageMatch;
+  };
+  const frame = () => {
+    if (!host.isConnected) return;
+    place();
+    requestAnimationFrame(frame);
+  };
+  const api = {close, select};
+  globalThis.heliumNeoImageMatch = api;
+  window.addEventListener('keydown', onKey, true);
+  (document.body || document.documentElement).append(host);
+  // A message without matches needs no action, so it goes away on its own.
+  const expiry = found.length || !controls ? 0 : setTimeout(close, 8000);
+  frame();
+  select(0);
+  return found.length;
+})
+)JS";
+
+// Starts loading up to |count| lazy images, nearest to the viewport first,
+// called as load(count). It never scrolls, so infinite scroll pages do not
+// fetch more content. Returns how many are loading.
+inline constexpr char kImageMatchLoadScript[] = R"JS(
+(count => {
+  const lazy = ['data-src', 'data-lazy-src', 'data-original', 'data-lazy', 'data-url'];
+  const lazySet = ['data-srcset', 'data-lazy-srcset'];
+  const real = value => value && !value.startsWith('data:');
+  // Script-driven lazy loading, such as lazysizes, shows an inline or tiny
+  // placeholder (often a 1x1 or 16x9 gif) until the image scrolls into view.
+  // Images under 24 pixels are too small to compare anyway.
+  const placeholder = img => !img.currentSrc || img.currentSrc.startsWith('data:') ||
+      (img.complete && (img.naturalWidth < 24 || img.naturalHeight < 24));
+  // With srcset descriptors in widths, 'auto' sizes come from the layout.
+  const sizes = (node, img) => {
+    const value = node.getAttribute('data-sizes');
+    if (!value || node.getAttribute('sizes')) return;
+    node.sizes = value === 'auto' ? Math.max(img.offsetWidth, 64) + 'px' : value;
+  };
+  const pending = new Set();
+  // A replaced placeholder still reports complete until the new request
+  // starts, so wait for the load events instead.
+  const wait = image => {
+    if (pending.has(image)) return;
+    pending.add(image);
+    const done = () => pending.delete(image);
+    image.addEventListener('load', done, {once: true});
+    image.addEventListener('error', done, {once: true});
+  };
+  const waiting = [];
+  for (const img of document.getElementsByTagName('img')) {
+    const standIn = placeholder(img);
+    if (img.complete && !standIn) continue;
+    // Collapsed placeholders still sit roughly where the image will be.
+    const rect = img.getBoundingClientRect();
+    const distance = Math.max(0, rect.top - innerHeight, -rect.bottom);
+    waiting.push({img, standIn, distance});
+  }
+  waiting.sort((a, b) => a.distance - b.distance);
+  for (const {img, standIn} of waiting.slice(0, count)) {
+    if (img.loading === 'lazy') img.loading = 'eager';
+    // Script-driven lazy loading keeps the real address in a data attribute.
+    if (standIn) {
+      let changed = false;
+      const picture = img.parentElement?.tagName === 'PICTURE' ? img.parentElement : null;
+      for (const source of picture ? picture.querySelectorAll('source') : []) {
+        const set = lazySet.map(name => source.getAttribute(name)).find(real);
+        if (set && source.getAttribute('srcset') !== set) {
+          sizes(source, img);
+          source.srcset = set;
+          changed = true;
+        }
+      }
+      const set = lazySet.map(name => img.getAttribute(name)).find(real);
+      if (set && img.getAttribute('srcset') !== set) {
+        sizes(img, img);
+        img.srcset = set;
+        changed = true;
+      }
+      const src = lazy.map(name => img.getAttribute(name)).find(real);
+      if (src && img.getAttribute('src') !== src) {
+        img.src = src;
+        changed = true;
+      }
+      if (changed) wait(img);
+    }
+    if (!img.complete) wait(img);
+  }
+  globalThis.heliumNeoImageLoad = pending;
+  return pending.size;
+})
+)JS";
+
+// Returns how many images started by kImageMatchLoadScript still load.
+inline constexpr char kImageMatchLoadPollScript[] = R"JS(
+(() => globalThis.heliumNeoImageLoad?.size ?? 0)()
+)JS";
+}  // namespace tabs
