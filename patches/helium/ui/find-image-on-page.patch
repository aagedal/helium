+#ifndef CHROME_BROWSER_UI_TABS_IMAGE_MATCH_COMPARE_H_
+#define CHROME_BROWSER_UI_TABS_IMAGE_MATCH_COMPARE_H_
+
+#include <cstdint>
+#include <vector>
+
+namespace tabs {
+
+// A small grayscale copy of an image, row by row.
+struct GrayImage {
+  int width = 0;
+  int height = 0;
+  std::vector<uint8_t> pixels;
+};
+
+// Compares images by appearance, tolerating resizing, recompression and
+// cropping in either direction: the query may be a crop of a candidate, or
+// a candidate a crop of the query. Cheap fingerprints find likely alignments
+// across scales and offsets; pixel correlation then confirms them.
+class ImageMatcher {
+ public:
+  // Thumbnails are at most this many pixels on their longest side.
+  static constexpr int kThumbnailSide = 64;
+
+  explicit ImageMatcher(const GrayImage& query);
+  ~ImageMatcher();
+  ImageMatcher(const ImageMatcher&) = delete;
+  ImageMatcher& operator=(const ImageMatcher&) = delete;
+
+  // False when the query is too small or plain to tell apart from others.
+  bool usable() const { return usable_; }
+
+  // Similarity in [0, 1] at the best alignment; 0 when nothing lines up.
+  // Matches score at least kMatchScore; untouched copies near 1.
+  float Compare(const GrayImage& candidate) const;
+
+  static constexpr float kMatchScore = 0.84f;
+  static constexpr float kSameScore = 0.96f;
+
+  // Summed-area table with bilinear lookups, public for the helpers.
+  struct Integral {
+    int width = 0;
+    int height = 0;
+    std::vector<double> sums;  // (width + 1) * (height + 1)
+  };
+
+ private:
+  bool usable_ = false;
+  Integral query_;
+};
+
+}  // namespace tabs
+
+#endif  // CHROME_BROWSER_UI_TABS_IMAGE_MATCH_COMPARE_H_
