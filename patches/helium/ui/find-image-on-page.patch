+#include "chrome/browser/ui/tabs/image_match_compare.h"
+
+#include <algorithm>
+#include <array>
+#include <bit>
+#include <cmath>
+#include <utility>
+
+namespace tabs {
+namespace {
+
+using Integral = ImageMatcher::Integral;
+
+// Fingerprint cells per side; one more than the bits per row.
+constexpr int kHashSide = 9;
+// Correlation cells per side.
+constexpr int kCorrelationSide = 16;
+// Windows narrower than this many thumbnail pixels carry too little detail.
+constexpr double kMinWindowSide = 10;
+// The smallest crop searched for, relative to the larger image.
+constexpr double kMinScale = 0.5;
+constexpr double kScaleStep = 0.07;
+constexpr double kOffsetStep = 0.08;
+// Coarse alignments refined per direction.
+constexpr size_t kRefinedCandidates = 3;
+// Out of 128 bits; above this the best alignment is not the same picture.
+constexpr int kMaxHashDistance = 30;
+// Standard deviation of the query, out of 255.
+constexpr double kMinContrast = 8;
+
+struct Window {
+  double x = 0;
+  double y = 0;
+  double width = 0;
+  double height = 0;
+};
+
+struct Hash {
+  uint64_t rows = 0;
+  uint64_t columns = 0;
+};
+
+// Brightness and its horizontal and vertical differences between cells.
+constexpr int kCorrelationCells = kCorrelationSide * kCorrelationSide;
+constexpr int kEdgeCells = kCorrelationSide * (kCorrelationSide - 1);
+using Correlation = std::array<float, kCorrelationCells + 2 * kEdgeCells>;
+
+struct Signature {
+  Hash hash;
+  Correlation correlation{};
+};
+
+Integral MakeIntegral(const GrayImage& image) {
+  Integral integral;
+  integral.width = image.width;
+  integral.height = image.height;
+  const int stride = image.width + 1;
+  integral.sums.assign(static_cast<size_t>(stride) * (image.height + 1), 0);
+  for (int y = 0; y < image.height; ++y) {
+    double row = 0;
+    for (int x = 0; x < image.width; ++x) {
+      row += image.pixels[static_cast<size_t>(y) * image.width + x];
+      integral.sums[(y + 1) * stride + x + 1] =
+          integral.sums[y * stride + x + 1] + row;
+    }
+  }
+  return integral;
+}
+
+// Sum of the image above and left of (x, y), at fractional positions.
+double SumAt(const Integral& integral, double x, double y) {
+  x = std::clamp(x, 0.0, static_cast<double>(integral.width));
+  y = std::clamp(y, 0.0, static_cast<double>(integral.height));
+  const int x0 = std::min(static_cast<int>(x), integral.width - 1);
+  const int y0 = std::min(static_cast<int>(y), integral.height - 1);
+  const double fx = x - x0;
+  const double fy = y - y0;
+  const int stride = integral.width + 1;
+  const double* row = &integral.sums[y0 * stride + x0];
+  const double top = row[0] + (row[1] - row[0]) * fx;
+  const double bottom =
+      row[stride] + (row[stride + 1] - row[stride]) * fx;
+  return top + (bottom - top) * fy;
+}
+
+// Average brightness of |window| split into side x side cells.
+template <int side>
+std::array<float, side * side> Grid(const Integral& integral,
+                                    const Window& window) {
+  std::array<double, (side + 1) * (side + 1)> corners;
+  for (int j = 0; j <= side; ++j) {
+    const double y = window.y + window.height * j / side;
+    for (int i = 0; i <= side; ++i) {
+      corners[j * (side + 1) + i] =
+          SumAt(integral, window.x + window.width * i / side, y);
+    }
+  }
+  const double area = window.width * window.height / (side * side);
+  std::array<float, side * side> cells;
+  for (int j = 0; j < side; ++j) {
+    for (int i = 0; i < side; ++i) {
+      const double* top = &corners[j * (side + 1) + i];
+      const double* bottom = top + side + 1;
+      cells[j * side + i] =
+          static_cast<float>((bottom[1] - bottom[0] - top[1] + top[0]) / area);
+    }
+  }
+  return cells;
+}
+
+// Brightness differences between neighbouring cells, across rows and columns.
+Hash HashOf(const Integral& integral, const Window& window) {
+  const auto cells = Grid<kHashSide>(integral, window);
+  Hash hash;
+  for (int y = 0; y < kHashSide - 1; ++y) {
+    for (int x = 0; x < kHashSide - 1; ++x) {
+      hash.rows = (hash.rows << 1) |
+                  (cells[y * kHashSide + x] < cells[y * kHashSide + x + 1]);
+      hash.columns = (hash.columns << 1) |
+                     (cells[x * kHashSide + y] < cells[(x + 1) * kHashSide + y]);
+    }
+  }
+  return hash;
+}
+
+int Distance(const Hash& a, const Hash& b) {
+  return std::popcount(a.rows ^ b.rows) + std::popcount(a.columns ^ b.columns);
+}
+
+// Makes |values| zero-mean and unit-length, so exposure and contrast changes
+// cancel out. Returns the standard deviation before normalizing.
+double Normalize(float* values, size_t count) {
+  double mean = 0;
+  for (size_t i = 0; i < count; ++i) {
+    mean += values[i];
+  }
+  mean /= count;
+  double norm = 0;
+  for (size_t i = 0; i < count; ++i) {
+    values[i] -= mean;
+    norm += values[i] * values[i];
+  }
+  if (norm > 0) {
+    const double scale = 1 / std::sqrt(norm);
+    for (size_t i = 0; i < count; ++i) {
+      values[i] *= scale;
+    }
+  }
+  return std::sqrt(norm / count);
+}
+
+// Brightness alone lets smooth, unrelated areas line up; the edges between
+// cells carry the picture's structure. Returns the brightness deviation.
+double CorrelationOf(const Integral& integral,
+                     const Window& window,
+                     Correlation& out) {
+  const auto cells = Grid<kCorrelationSide>(integral, window);
+  std::copy(cells.begin(), cells.end(), out.begin());
+  float* edges = out.data() + kCorrelationCells;
+  for (int y = 0; y < kCorrelationSide; ++y) {
+    for (int x = 0; x + 1 < kCorrelationSide; ++x) {
+      *edges++ = cells[y * kCorrelationSide + x + 1] -
+                 cells[y * kCorrelationSide + x];
+      *edges++ = cells[(x + 1) * kCorrelationSide + y] -
+                 cells[x * kCorrelationSide + y];
+    }
+  }
+  Normalize(out.data() + kCorrelationCells, 2 * kEdgeCells);
+  return Normalize(out.data(), kCorrelationCells);
+}
+
+// The weaker of the brightness and edge correlations.
+float Correlate(const Correlation& a, const Correlation& b) {
+  float brightness = 0;
+  for (int i = 0; i < kCorrelationCells; ++i) {
+    brightness += a[i] * b[i];
+  }
+  float edges = 0;
+  for (size_t i = kCorrelationCells; i < a.size(); ++i) {
+    edges += a[i] * b[i];
+  }
+  return std::min(brightness, edges);
+}
+
+Window Whole(const Integral& integral) {
+  return {0, 0, static_cast<double>(integral.width),
+          static_cast<double>(integral.height)};
+}
+
+// Moves |window| inside |integral|; false when it does not fit.
+bool Fit(const Integral& integral, Window& window) {
+  if (window.width > integral.width + 1e-6 ||
+      window.height > integral.height + 1e-6 ||
+      std::min(window.width, window.height) < kMinWindowSide) {
+    return false;
+  }
+  window.x = std::clamp(window.x, 0.0, integral.width - window.width);
+  window.y = std::clamp(window.y, 0.0, integral.height - window.height);
+  return true;
+}
+
+// Best correlation between |target| and a window of |area| with the
+// target's |aspect|, over crops from the whole area down to kMinScale.
+float Search(const Integral& area, double aspect, const Signature& target) {
+  double fit_width = area.width;
+  double fit_height = fit_width / aspect;
+  if (fit_height > area.height) {
+    fit_height = area.height;
+    fit_width = fit_height * aspect;
+  }
+
+  // Coarse pass: fingerprints at every scale and offset.
+  std::vector<std::pair<int, Window>> candidates;
+  for (double scale = 1; scale >= kMinScale - 1e-6; scale -= kScaleStep) {
+    const double width = fit_width * scale;
+    const double height = fit_height * scale;
+    if (std::min(width, height) < kMinWindowSide) {
+      break;
+    }
+    const double step_x = std::max(width * kOffsetStep, 0.5);
+    const double step_y = std::max(height * kOffsetStep, 0.5);
+    const double last_x = area.width - width;
+    const double last_y = area.height - height;
+    for (double y = 0;; y = std::min(y + step_y, last_y)) {
+      for (double x = 0;; x = std::min(x + step_x, last_x)) {
+        const Window window{x, y, width, height};
+        candidates.emplace_back(Distance(HashOf(area, window), target.hash),
+                                window);
+        if (x >= last_x) {
+          break;
+        }
+      }
+      if (y >= last_y) {
+        break;
+      }
+    }
+  }
+  const size_t kept = std::min(candidates.size(), kRefinedCandidates);
+  std::partial_sort(
+      candidates.begin(), candidates.begin() + kept, candidates.end(),
+      [](const auto& a, const auto& b) { return a.first < b.first; });
+
+  // Fine pass: climb towards the best correlation around each candidate.
+  float best = 0;
+  Correlation cells;
+  for (size_t c = 0; c < kept; ++c) {
+    if (candidates[c].first > kMaxHashDistance) {
+      break;
+    }
+    Window current = candidates[c].second;
+    CorrelationOf(area, current, cells);
+    float score = Correlate(cells, target.correlation);
+    for (double reach = 1; reach >= 0.125; reach /= 2) {
+      for (int climb = 0; climb < 4; ++climb) {
+        Window next = current;
+        float next_score = score;
+        for (int ds = -1; ds <= 1; ++ds) {
+          for (int dy = -1; dy <= 1; ++dy) {
+            for (int dx = -1; dx <= 1; ++dx) {
+              if (!ds && !dx && !dy) {
+                continue;
+              }
+              const double factor = 1 + ds * 0.05 * reach;
+              Window window{0, 0, current.width * factor,
+                            current.height * factor};
+              window.x = current.x + (current.width - window.width) / 2 +
+                         dx * kOffsetStep * current.width * reach;
+              window.y = current.y + (current.height - window.height) / 2 +
+                         dy * kOffsetStep * current.height * reach;
+              if (!Fit(area, window)) {
+                continue;
+              }
+              CorrelationOf(area, window, cells);
+              const float value = Correlate(cells, target.correlation);
+              if (value > next_score) {
+                next_score = value;
+                next = window;
+              }
+            }
+          }
+        }
+        if (next_score <= score) {
+          break;
+        }
+        score = next_score;
+        current = next;
+      }
+    }
+    if (score > best &&
+        Distance(HashOf(area, current), target.hash) <= kMaxHashDistance) {
+      best = score;
+    }
+  }
+  return best;
+}
+
+// Corners and centre of |integral|, each covering most of it, for crops that
+// overlap without one containing the other.
+std::array<Window, 5> Parts(const Integral& integral) {
+  constexpr double kPart = 0.6;
+  const double width = integral.width * kPart;
+  const double height = integral.height * kPart;
+  const double right = integral.width - width;
+  const double bottom = integral.height - height;
+  return {{{0, 0, width, height},
+           {right, 0, width, height},
+           {0, bottom, width, height},
+           {right, bottom, width, height},
+           {right / 2, bottom / 2, width, height}}};
+}
+
+Signature SignatureOf(const Integral& integral,
+                      const Window& window,
+                      double* deviation = nullptr) {
+  Signature signature;
+  signature.hash = HashOf(integral, window);
+  const double value = CorrelationOf(integral, window, signature.correlation);
+  if (deviation) {
+    *deviation = value;
+  }
+  return signature;
+}
+
+Signature SignatureOf(const Integral& integral, double* deviation = nullptr) {
+  Signature signature;
+  const Window whole = Whole(integral);
+  signature.hash = HashOf(integral, whole);
+  const double value =
+      CorrelationOf(integral, whole, signature.correlation);
+  if (deviation) {
+    *deviation = value;
+  }
+  return signature;
+}
+
+bool Valid(const GrayImage& image) {
+  return image.width >= kMinWindowSide && image.height >= kMinWindowSide &&
+         image.width <= ImageMatcher::kThumbnailSide &&
+         image.height <= ImageMatcher::kThumbnailSide &&
+         image.pixels.size() ==
+             static_cast<size_t>(image.width) * image.height;
+}
+
+}  // namespace
+
+ImageMatcher::ImageMatcher(const GrayImage& query) {
+  if (!Valid(query)) {
+    return;
+  }
+  query_ = MakeIntegral(query);
+  double deviation = 0;
+  SignatureOf(query_, &deviation);
+  usable_ = deviation >= kMinContrast;
+}
+
+ImageMatcher::~ImageMatcher() = default;
+
+float ImageMatcher::Compare(const GrayImage& candidate) const {
+  if (!usable_ || !Valid(candidate)) {
+    return 0;
+  }
+  const Integral image = MakeIntegral(candidate);
+  double deviation = 0;
+  const Signature candidate_signature = SignatureOf(image, &deviation);
+  if (deviation < kMinContrast) {
+    return 0;
+  }
+  const Signature query_signature = SignatureOf(query_);
+  const double query_aspect =
+      static_cast<double>(query_.width) / query_.height;
+  const double candidate_aspect =
+      static_cast<double>(image.width) / image.height;
+  // The query cropped from the candidate, and the candidate from the query.
+  float best = std::max(Search(image, query_aspect, query_signature),
+                        Search(query_, candidate_aspect, candidate_signature));
+  if (best >= kMatchScore) {
+    return best;
+  }
+  // Two different crops of one picture: some part of either must still
+  // appear in the other.
+  for (const Window& part : Parts(query_)) {
+    best = std::max(best, Search(image, part.width / part.height,
+                                 SignatureOf(query_, part)));
+  }
+  for (const Window& part : Parts(image)) {
+    best = std::max(best, Search(query_, part.width / part.height,
+                                 SignatureOf(image, part)));
+  }
+  return best;
+}
+
+}  // namespace tabs
