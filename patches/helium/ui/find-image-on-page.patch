+void FindBarView::AppendDropFormats(
+    int* formats,
+    std::set<ui::ClipboardFormatType>* format_types) {
+  *formats |= kImageDropFormats;
+}
+
+views::View::DropCallback FindBarView::CreateDropCallback(
+    const ui::DropTargetEvent& event) {
+  // Dropped text still goes into the text field.
+  if (!event.data().HasAnyFormat(kImageDropFormats, {})) {
+    return base::NullCallback();
+  }
+  return GetDropCallback(event);
+}
+
+void FindBarView::DropImage(
+    const ui::DropTargetEvent& event,
+    ui::mojom::DragOperation& output_drag_op,
+    std::unique_ptr<ui::LayerTreeOwner> drag_image_layer_owner) {
+  output_drag_op = ui::mojom::DragOperation::kNone;
+  if (!GetWebContents()) {
+    return;
+  }
+  // Files first: images dragged from a page only promise a file, and their
+  // data is the image itself.
+  if (std::optional<std::vector<ui::FileInfo>> files =
+          event.data().GetFilenames();
+      files && !files->empty()) {
+    output_drag_op = ui::mojom::DragOperation::kCopy;
+    SearchForImageFile(files->front().path);
+    return;
+  }
+  if (std::optional<ui::OSExchangeData::FileContentsInfo> contents =
+          event.data().GetFileContents();
+      contents && !contents->file_contents.empty()) {
+    output_drag_op = ui::mojom::DragOperation::kCopy;
+    StartImageSearch();
+    SearchForEncodedImage(std::move(contents->file_contents));
+  }
+}
+
+void FindBarView::SearchForImageFile(const base::FilePath& path) {
+  StartImageSearch();
+  base::ThreadPool::PostTaskAndReplyWithResult(
+      FROM_HERE, {base::MayBlock(), base::TaskPriority::USER_VISIBLE},
+      base::BindOnce(&ReadImageFile, path),
+      base::BindOnce(&FindBarView::SearchForEncodedImage,
+                     weak_factory_.GetWeakPtr()));
+}
+
+void FindBarView::OnMenuPastePng(const std::vector<uint8_t>& png) {
+  StartImageSearch();
+  if (png.empty()) {
+    SetImageStatus(IDS_NEO_IMAGE_MATCH_NO_CLIPBOARD_IMAGE);
+    return;
+  }
+  SearchForEncodedImage(png);
+}
+
+void FindBarView::StartImageSearch() {
+  content::WebContents* contents = GetWebContents();
+  if (image_contents_ && image_contents_.get() != contents) {
+    tabs::ClearImageMatches(image_contents_.get());
+  }
+  image_contents_ = contents ? contents->GetWeakPtr() : nullptr;
+  if (contents) {
+    // Text matches would compete with the image outlines.
+    find_in_page::FindTabHelper::FromWebContents(contents)->StopFinding(
+        find_in_page::SelectionAction::kClear);
+  }
+  image_mode_ = true;
+  ++image_search_generation_;
+  image_match_count_ = 0;
+  image_match_index_ = 0;
+  find_text_->SetText(std::u16string());
+  last_searched_text_.clear();
+  find_text_->SetPlaceholderText(
+      l10n_util::GetStringUTF16(IDS_NEO_IMAGE_MATCH_SEARCHING));
+  match_count_text_->ClearResult();
+  UpdateMatchCountAppearance(true);
+  find_text_->RequestFocus();
+}
+
+void FindBarView::SearchForEncodedImage(std::vector<uint8_t> data) {
+  if (!image_mode_) {
+    return;
+  }
+  if (data.empty()) {
+    SetImageStatus(IDS_NEO_IMAGE_MATCH_UNREADABLE);
+    return;
+  }
+  // Untrusted image data is only decoded in the sandboxed decoder.
+  const int generation = image_search_generation_;
+  data_decoder::DecodeImageIsolated(
+      data, data_decoder::mojom::ImageCodec::kDefault,
+      /*shrink_to_fit=*/true, data_decoder::kDefaultMaxSizeInBytes,
+      gfx::Size(),
+      base::BindOnce(
+          [](base::WeakPtr<FindBarView> view, int generation,
+             const SkBitmap& image) {
+            if (!view || generation != view->image_search_generation_) {
+              return;
+            }
+            if (image.drawsNothing()) {
+              view->SetImageStatus(IDS_NEO_IMAGE_MATCH_UNREADABLE);
+              return;
+            }
+            view->SearchForImage(image);
+          },
+          weak_factory_.GetWeakPtr(), generation));
+}
+
+void FindBarView::SearchForImage(const SkBitmap& image) {
+  content::WebContents* contents = image_contents_.get();
+  if (!contents || contents != GetWebContents()) {
+    ExitImageMode();
+    return;
+  }
+  const gfx::ImageSkia preview = gfx::ImageSkia::CreateFrom1xBitmap(image);
+  const double scale = static_cast<double>(kImagePreviewSize) /
+                       std::max(image.width(), image.height());
+  const gfx::Size size(std::max(1, static_cast<int>(image.width() * scale)),
+                       std::max(1, static_cast<int>(image.height() * scale)));
+  image_preview_->SetImage(ui::ImageModel::FromImageSkia(
+      gfx::ImageSkiaOperations::CreateResizedImage(
+          preview, skia::ImageOperations::RESIZE_GOOD, size)));
+  image_preview_->SetVisible(true);
+  tabs::FindImageOnPage(
+      contents, image,
+      base::BindOnce(&FindBarView::OnImageSearchDone,
+                     weak_factory_.GetWeakPtr(), image_search_generation_));
+}
+
+void FindBarView::OnImageSearchDone(int generation, int count, bool usable) {
+  if (!image_mode_ || generation != image_search_generation_) {
+    return;
+  }
+  if (!usable) {
+    SetImageStatus(IDS_NEO_IMAGE_MATCH_TOO_PLAIN);
+    return;
+  }
+  image_match_count_ = count;
+  image_match_index_ = 0;
+  find_text_->SetPlaceholderText(l10n_util::GetStringUTF16(
+      count ? IDS_NEO_IMAGE_MATCH_PLACEHOLDER
+            : IDS_NEO_IMAGE_MATCH_NONE_ON_PAGE));
+  UpdateImageMatchCount();
+}
+
+void FindBarView::SetImageStatus(int message_id) {
+  image_match_count_ = 0;
+  find_text_->SetPlaceholderText(l10n_util::GetStringUTF16(message_id));
+  match_count_text_->ClearResult();
+  UpdateMatchCountAppearance(true);
+  DeprecatedLayoutImmediately();
+  SchedulePaint();
+}
+
+void FindBarView::StepImageMatch(bool reverse) {
+  if (!image_match_count_ || !image_contents_) {
+    return;
+  }
+  image_match_index_ =
+      (image_match_index_ + (reverse ? -1 : 1) + image_match_count_) %
+      image_match_count_;
+  tabs::SelectImageMatch(image_contents_.get(), image_match_index_);
+  UpdateImageMatchCount();
+}
+
+void FindBarView::UpdateImageMatchCount() {
+  match_count_text_->SetResult(find_in_page::FindNotificationDetails(
+      image_search_generation_, image_match_count_, gfx::Rect(),
+      image_match_count_ ? image_match_index_ + 1 : 0, /*final_update=*/true));
+  UpdateMatchCountAppearance(image_match_count_ == 0);
+  DeprecatedLayoutImmediately();
+  SchedulePaint();
+}
+
+void FindBarView::ExitImageMode() {
+  if (!image_mode_) {
+    return;
+  }
+  image_mode_ = false;
+  ++image_search_generation_;
+  image_match_count_ = 0;
+  if (image_contents_) {
+    tabs::ClearImageMatches(image_contents_.get());
+  }
+  image_contents_ = nullptr;
+  image_preview_->SetVisible(false);
+  find_text_->SetPlaceholderText(std::u16string());
+  ClearMatchCount();
+}
