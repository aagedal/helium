+#ifndef CHROME_COMMON_IMAGE_MATCH_THUMBNAIL_H_
+#define CHROME_COMMON_IMAGE_MATCH_THUMBNAIL_H_
+
+#include <cstdint>
+#include <vector>
+
+class SkBitmap;
+
+namespace image_match {
+
+// Images smaller than this on either side, such as icons, are not compared.
+inline constexpr int kThumbnailMinSize = 24;
+// Thumbnails are at most this many pixels on their longest side.
+inline constexpr int kThumbnailSide = 64;
+
+struct Thumbnail {
+  int width = 0;
+  int height = 0;
+  // Brightness, row by row, with transparent areas shown over white.
+  std::vector<uint8_t> luma;
+};
+
+// Shrinks |image| to a grayscale thumbnail for appearance matching. Returns
+// an empty thumbnail when |image| is missing or too small.
+Thumbnail MakeThumbnail(const SkBitmap& image);
+
+}  // namespace image_match
