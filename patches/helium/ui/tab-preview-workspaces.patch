+namespace tabs {
+namespace {
+class ReloadCounter : public content::WebContentsObserver {
+ public:
+  explicit ReloadCounter(content::WebContents* contents)
+      : content::WebContentsObserver(contents) {}
+  void DidStartNavigation(content::NavigationHandle* handle) override {
+    if (handle->IsInPrimaryMainFrame()) {
+      ++count;
+    }
+  }
+  int count = 0;
+};
+}  // namespace
+
+class PaneSettingsTest : public ChromeRenderViewHostTestHarness {
+ public:
+  PaneSettingsTest()
+      : ChromeRenderViewHostTestHarness(
+            base::test::TaskEnvironment::TimeSource::MOCK_TIME) {}
+  void SetUp() override {
+    ChromeRenderViewHostTestHarness::SetUp();
+    NavigateAndCommit(GURL("https://example.test/"));
+  }
+};
+
+TEST_F(PaneSettingsTest, RefreshStartsAtIntervalAndOffCancels) {
+  ReloadCounter counter(web_contents());
+  auto* settings = PaneSettings::GetOrCreate(web_contents());
+  settings->SetRefreshSeconds(15);
+  task_environment()->FastForwardBy(base::Seconds(14));
+  EXPECT_EQ(counter.count, 0);
+  task_environment()->FastForwardBy(base::Seconds(1));
+  EXPECT_EQ(counter.count, 1);
+  content::NavigationSimulator::CreateFromPending(web_contents())->Commit();
+  settings->SetRefreshSeconds(0);
+  task_environment()->FastForwardBy(base::Minutes(6));
+  EXPECT_EQ(counter.count, 1);
+}
+
+TEST_F(PaneSettingsTest, ChangingIntervalReplacesTimer) {
+  ReloadCounter counter(web_contents());
+  auto* settings = PaneSettings::GetOrCreate(web_contents());
+  settings->SetRefreshSeconds(15);
+  task_environment()->FastForwardBy(base::Seconds(10));
+  settings->SetRefreshSeconds(180);
+  task_environment()->FastForwardBy(base::Seconds(179));
+  EXPECT_EQ(counter.count, 0);
+  task_environment()->FastForwardBy(base::Seconds(1));
+  EXPECT_EQ(counter.count, 1);
+}
+
+TEST_F(PaneSettingsTest, RefreshIsIndividualAndStopsWithTab) {
+  auto other = content::WebContents::Create(
+      content::WebContents::CreateParams(profile()));
+  content::NavigationSimulator::NavigateAndCommitFromBrowser(
+      other.get(), GURL("https://other.test/"));
+  ReloadCounter first(web_contents());
+  ReloadCounter second(other.get());
+  PaneSettings::GetOrCreate(other.get())->SetRefreshSeconds(15);
+  task_environment()->FastForwardBy(base::Seconds(15));
+  EXPECT_EQ(first.count, 0);
+  EXPECT_EQ(second.count, 1);
+  other.reset();
+  task_environment()->FastForwardBy(base::Minutes(6));
+  EXPECT_EQ(first.count, 0);
+}
+
+TEST_F(PaneSettingsTest, SkipsPostLoadingAndDiscardedTabs) {
+  ReloadCounter counter(web_contents());
+  auto* settings = PaneSettings::GetOrCreate(web_contents());
+  settings->SetRefreshSeconds(15);
+  auto* entry = web_contents()->GetController().GetLastCommittedEntry();
+  entry->SetHasPostData(true);
+  task_environment()->FastForwardBy(base::Seconds(15));
+  EXPECT_EQ(counter.count, 0);
+  entry->SetHasPostData(false);
+  web_contents()->GetController().SetNeedsReload();
+  task_environment()->FastForwardBy(base::Seconds(15));
+  EXPECT_EQ(counter.count, 0);
+  web_contents()->GetController().LoadIfNecessary();
+  EXPECT_EQ(counter.count, 1);
+  task_environment()->FastForwardBy(base::Seconds(30));
+  EXPECT_EQ(counter.count, 1);
+}
+
+TEST_F(PaneSettingsTest, MobilePreviewAttachesWithoutFrontendAndDisables) {
+  auto host = content::DevToolsAgentHost::GetOrCreateFor(web_contents());
+  auto* settings = PaneSettings::GetOrCreate(web_contents());
+  EXPECT_FALSE(host->IsAttached());
+  settings->SetMobileEnabled(true);
+  EXPECT_TRUE(settings->mobile_enabled());
+  EXPECT_TRUE(host->IsAttached());
+  settings->SetMobileEnabled(false);
+  EXPECT_FALSE(settings->mobile_enabled());
+  EXPECT_FALSE(host->IsAttached());
+}
+
+TEST_F(PaneSettingsTest, ProtocolFailureClearsMobileToggle) {
+  auto* settings = PaneSettings::GetOrCreate(web_contents());
+  settings->SetMobileEnabled(true);
+  const std::string error = R"({"id":1,"error":{"code":-32000}})";
+  settings->DispatchProtocolMessage(nullptr, base::as_byte_span(error));
+  EXPECT_FALSE(settings->mobile_enabled());
+  EXPECT_FALSE(
+      content::DevToolsAgentHost::GetOrCreateFor(web_contents())->IsAttached());
+}
+
+TEST_F(PaneSettingsTest, RestoreRejectsInvalidIntervalsAndRoundTrips) {
+  auto* settings = PaneSettings::GetOrCreate(web_contents());
+  for (const auto* bad : {"-15", "1", "14", "181", "195", "invalid"}) {
+    PaneSettings::RestoreFromExtraData(web_contents(),
+                                       {{"helium.auto_refresh_seconds", bad}});
+    EXPECT_EQ(settings->refresh_seconds(), 0);
+  }
+  for (int seconds = 0; seconds <= 180; seconds += 15) {
+    settings->SetRefreshSeconds(seconds);
+    std::map<std::string, std::string> data;
+    PaneSettings::PopulateExtraData(web_contents(), &data);
+    settings->SetRefreshSeconds(0);
+    PaneSettings::RestoreFromExtraData(web_contents(), data);
+    EXPECT_EQ(settings->refresh_seconds(), seconds);
+  }
+}
