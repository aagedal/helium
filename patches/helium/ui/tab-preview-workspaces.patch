+// Copyright 2026 The Helium Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_TABS_PANE_SETTINGS_GEOMETRY_H_
+#define CHROME_BROWSER_UI_TABS_PANE_SETTINGS_GEOMETRY_H_
+
+#include <algorithm>
+#include <cmath>
+
+namespace tabs {
+inline constexpr int kMobilePreviewWidth = 402;
+inline constexpr int kMobilePreviewHeight = 874;
+inline constexpr double kMobilePreviewDeviceScaleFactor = 3.0;
+inline constexpr int kAutoRefreshStepSeconds = 15;
+inline constexpr int kAutoRefreshMaxSeconds = 180;
+
+constexpr bool IsValidAutoRefreshInterval(int seconds) {
+  return seconds >= 0 && seconds <= kAutoRefreshMaxSeconds &&
+         seconds % kAutoRefreshStepSeconds == 0;
+}
+
+struct MobilePreviewBounds {
+  int x;
+  int y;
+  int width;
+  int height;
+  double scale;
+};
+
+// Fit the entire fixed CSS viewport, without stretching or upscaling it.
+inline MobilePreviewBounds FitMobilePreview(int width, int height) {
+  if (width <= 0 || height <= 0) {
+    return {0, 0, 0, 0, 0};
+  }
+  const double scale =
+      std::min({1.0, static_cast<double>(width) / kMobilePreviewWidth,
+                static_cast<double>(height) / kMobilePreviewHeight});
+  const int fitted_width = std::min(
+      width,
+      std::max(1, static_cast<int>(std::floor(kMobilePreviewWidth * scale))));
+  const int fitted_height = std::min(
+      height,
+      std::max(1, static_cast<int>(std::floor(kMobilePreviewHeight * scale))));
+  return {(width - fitted_width) / 2, (height - fitted_height) / 2,
+          fitted_width, fitted_height, scale};
+}
+}  // namespace tabs
+
+#endif  // CHROME_BROWSER_UI_TABS_PANE_SETTINGS_GEOMETRY_H_
