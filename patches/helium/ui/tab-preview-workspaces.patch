+#include "ui/base/models/menu_separator_types.h"
+
+namespace tabs {
+namespace {
+constexpr char kWorkspacePref[] = "helium.preview_workspaces";
+}
+
+PaneSettingsMenuModel::PaneSettingsMenuModel(TabStripModel* model,
+                                             tabs::TabInterface* tab)
+    : ui::SimpleMenuModel(this), model_(model), tab_(tab->GetWeakPtr()) {
+  AddCheckItem(kMobileCommandId,
+               l10n_util::GetStringUTF16(IDS_HELIUM_MOBILE_PREVIEW));
+  AddItemWithStringId(kWorkspaceCommandId, IDS_HELIUM_CREATE_PREVIEW_WORKSPACE);
+  AddSeparator(ui::MenuSeparatorType::NORMAL_SEPARATOR);
+  refresh_menu_ = std::make_unique<ui::SimpleMenuModel>(this);
+  for (int seconds = 0; seconds <= kAutoRefreshMaxSeconds;
+       seconds += kAutoRefreshStepSeconds) {
+    const std::u16string label =
+        seconds == 0
+            ? l10n_util::GetStringUTF16(IDS_HELIUM_AUTO_REFRESH_OFF)
+            : l10n_util::GetStringFUTF16(IDS_HELIUM_AUTO_REFRESH_SECONDS,
+                                         base::NumberToString16(seconds));
+    refresh_menu_->AddRadioItem(
+        kRefreshFirstCommandId + seconds / kAutoRefreshStepSeconds, label, 1);
+  }
+  AddSubMenuWithStringId(kRefreshParentCommandId, IDS_HELIUM_AUTO_REFRESH,
+                         refresh_menu_.get());
+}
+
+PaneSettingsMenuModel::~PaneSettingsMenuModel() = default;
+
+bool PaneSettingsMenuModel::IsCommandIdChecked(int command_id) const {
+  if (!tab_) {
+    return false;
+  }
+  auto* settings = PaneSettings::FromWebContents(tab_->GetContents());
+  if (command_id == kMobileCommandId) {
+    return settings && settings->mobile_enabled();
+  }
+  const int seconds =
+      (command_id - kRefreshFirstCommandId) * kAutoRefreshStepSeconds;
+  return IsValidAutoRefreshInterval(seconds) &&
+         seconds == (settings ? settings->refresh_seconds() : 0);
+}
+
+bool PaneSettingsMenuModel::IsCommandIdEnabled(int command_id) const {
+  if (!tab_ || model_->GetIndexOfTab(tab_.get()) == TabStripModel::kNoTab) {
+    return false;
+  }
+  if (command_id == kWorkspaceCommandId) {
+    auto* browser = model_->delegate()->GetBrowserWindowInterface();
+    return tab_->GetContents()->GetVisibleURL().SchemeIsHTTPOrHTTPS() &&
+           browser && model_->SupportsTabGroups() &&
+           !browser->GetProfile()->IsOffTheRecord() &&
+           tab_groups::SavedTabGroupUtils::IsEnabledForProfile(
+               browser->GetProfile());
+  }
+  // Off always remains available, even after navigating to a browser page.
+  if (command_id == kRefreshFirstCommandId ||
+      (command_id == kMobileCommandId && IsCommandIdChecked(command_id))) {
+    return true;
+  }
+  return tab_->GetContents()->GetVisibleURL().SchemeIsHTTPOrHTTPS();
+}
+
+void PaneSettingsMenuModel::ExecuteCommand(int command_id, int event_flags) {
+  if (!IsCommandIdEnabled(command_id)) {
+    return;
+  }
+  if (command_id == kWorkspaceCommandId) {
+    CreateWorkspace();
+    return;
+  }
+  auto* settings = PaneSettings::GetOrCreate(tab_->GetContents());
+  if (command_id == kMobileCommandId) {
+    settings->SetMobileEnabled(!settings->mobile_enabled());
+  } else {
+    const int seconds =
+        (command_id - kRefreshFirstCommandId) * kAutoRefreshStepSeconds;
+    if (!IsValidAutoRefreshInterval(seconds)) {
+      return;
+    }
+    settings->SetRefreshSeconds(seconds);
+  }
+  SaveWorkspaceSettings();
+}
+
+void PaneSettingsMenuModel::CreateWorkspace() {
+  auto* browser = model_->delegate()->GetBrowserWindowInterface();
+  auto* service = tab_groups::TabGroupSyncServiceFactory::GetForProfile(
+      browser->GetProfile());
+  if (!service) {
+    return;
+  }
+  // Copy both pages so creating a workspace never changes an existing split,
+  // group, pinned tab, or its refresh setting.
+  auto desktop_contents = tab_->GetContents()->Clone();
+  auto mobile_contents = tab_->GetContents()->Clone();
+  auto* desktop = desktop_contents.get();
+  auto* mobile = mobile_contents.get();
+  model_->InsertWebContentsAt(model_->count(), std::move(desktop_contents),
+                              AddTabTypes::ADD_ACTIVE);
+  model_->InsertWebContentsAt(model_->count(), std::move(mobile_contents), 0);
+  const auto group =
+      model_->AddToNewGroup({model_->GetIndexOfWebContents(desktop),
+                             model_->GetIndexOfWebContents(mobile)});
+  model_->ChangeTabGroupVisuals(
+      group, tab_groups::TabGroupVisualData(
+                 l10n_util::GetStringUTF16(IDS_HELIUM_PREVIEW_WORKSPACE_TITLE),
+                 tab_groups::TabGroupColorId::kBlue));
+  model_->AddToNewSplit({model_->GetIndexOfWebContents(desktop),
+                         model_->GetIndexOfWebContents(mobile)},
+                        split_tabs::SplitTabVisualData(
+                            split_tabs::SplitTabLayout::kSideBySide, 0.65),
+                        split_tabs::SplitTabCreatedSource::kTabContextMenu);
+  PaneSettings::GetOrCreate(mobile)->SetMobileEnabled(true);
+  if (auto* session = SessionServiceFactory::GetForProfileIfExisting(
+          browser->GetProfile())) {
+    session->TabRestored(desktop, false);
+    session->TabRestored(mobile, false);
+  }
+  auto saved_group = service->GetGroup(group);
+  if (!saved_group) {
+    return;
+  }
+  service->UpdateGroupPosition(saved_group->saved_guid(), true, std::nullopt);
+
+  // Save stable saved-tab IDs so reopening works after tab reordering.
+  const auto* saved_desktop = saved_group->GetTab(
+      model_->GetTabForWebContents(desktop)->GetHandle().raw_value());
+  const auto* saved_mobile = saved_group->GetTab(
+      model_->GetTabForWebContents(mobile)->GetHandle().raw_value());
+  if (saved_desktop && saved_mobile) {
+    ScopedDictPrefUpdate update(browser->GetProfile()->GetPrefs(),
+                                kWorkspacePref);
+    base::DictValue workspace;
+    workspace.Set("desktop",
+                  saved_desktop->saved_tab_guid().AsLowercaseString());
+    workspace.Set("mobile", saved_mobile->saved_tab_guid().AsLowercaseString());
+    update->Set(saved_group->saved_guid().AsLowercaseString(),
+                std::move(workspace));
+  }
+  // Save settings for both copies through the same tab-specific path.
+  auto original_tab = tab_;
+  tab_ = model_->GetTabForWebContents(desktop)->GetWeakPtr();
+  SaveWorkspaceSettings();
+  tab_ = model_->GetTabForWebContents(mobile)->GetWeakPtr();
+  SaveWorkspaceSettings();
+  tab_ = original_tab;
+}
+
+void PaneSettingsMenuModel::SaveWorkspaceSettings() {
+  if (!tab_ || !tab_->GetGroup()) {
+    return;
+  }
+  auto* browser = model_->delegate()->GetBrowserWindowInterface();
+  if (!browser || browser->GetProfile()->IsOffTheRecord()) {
+    return;
+  }
+  auto* service = tab_groups::TabGroupSyncServiceFactory::GetForProfile(
+      browser->GetProfile());
+  auto saved = service ? service->GetGroup(*tab_->GetGroup()) : std::nullopt;
+  if (!saved) {
+    return;
+  }
+  const auto* saved_tab = saved->GetTab(tab_->GetHandle().raw_value());
+  if (!saved_tab) {
+    return;
+  }
+  std::map<std::string, std::string> data;
+  PaneSettings::PopulateExtraData(tab_->GetContents(), &data);
+  base::DictValue settings;
+  for (const auto& [key, value] : data) {
+    settings.Set(key, value);
+  }
+  ScopedDictPrefUpdate update(browser->GetProfile()->GetPrefs(),
+                              kWorkspacePref);
+  auto* workspace = update->EnsureDict(saved->saved_guid().AsLowercaseString());
+  workspace->EnsureDict("tabs")->Set(
+      saved_tab->saved_tab_guid().AsLowercaseString(), std::move(settings));
+}
