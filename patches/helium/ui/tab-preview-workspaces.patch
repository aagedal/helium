+namespace tabs {
+// Per-WebContents settings, independent of selection and the split layout.
+class PaneSettings : public content::WebContentsObserver,
+                     public content::WebContentsUserData<PaneSettings>,
+                     public content::DevToolsAgentHostClient {
+ public:
+  ~PaneSettings() override;
+  static PaneSettings* GetOrCreate(content::WebContents* contents);
+  static void PopulateExtraData(content::WebContents* contents,
+                                std::map<std::string, std::string>* data);
+  static void RestoreFromExtraData(
+      content::WebContents* contents,
+      const std::map<std::string, std::string>& data);
+
+  bool mobile_enabled() const { return mobile_enabled_; }
+  int refresh_seconds() const { return refresh_seconds_; }
+  void SetMobileEnabled(bool enabled);
+  void SetRefreshSeconds(int seconds);
+  void SetPreviewScale(double scale);
+  base::CallbackListSubscription RegisterChanged(
+      base::RepeatingClosure callback);
+
+  void WebContentsDestroyed() override;
+  void RenderFrameCreated(content::RenderFrameHost* frame) override;
+  void PrimaryPageChanged(content::Page& page) override;
+  void DispatchProtocolMessage(content::DevToolsAgentHost* host,
+                               base::span<const uint8_t> message) override;
+  void AgentHostClosed(content::DevToolsAgentHost* host) override;
+  bool MayAttachToURL(const GURL& url, bool is_webui) override;
+
+ private:
+  friend class content::WebContentsUserData<PaneSettings>;
+  explicit PaneSettings(content::WebContents* contents);
+  void ApplyMobileEmulation();
+  void SendCommand(const char* method, base::DictValue params);
+  void Refresh();
+  void Save();
+  void Detach();
+
+  bool mobile_enabled_ = false;
+  int refresh_seconds_ = 0;
+  double preview_scale_ = 1.0;
+  int next_command_id_ = 0;
+  scoped_refptr<content::DevToolsAgentHost> agent_host_;
+  base::RepeatingTimer refresh_timer_;
+  base::RepeatingClosureList changed_callbacks_;
+  WEB_CONTENTS_USER_DATA_KEY_DECL();
+};
+}  // namespace tabs
