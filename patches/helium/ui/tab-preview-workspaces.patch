+// Copyright 2026 The Helium Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "chrome/browser/ui/tabs/pane_settings.h"
+
+#include <string_view>
+#include <utility>
+
+#include "base/functional/bind.h"
+#include "base/json/json_reader.h"
+#include "base/json/json_writer.h"
+#include "base/strings/string_number_conversions.h"
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/browser/sessions/session_service.h"
+#include "chrome/browser/sessions/session_service_factory.h"
+#include "components/sessions/content/session_tab_helper.h"
+#include "content/public/browser/devtools_agent_host.h"
+#include "content/public/browser/navigation_controller.h"
+#include "content/public/browser/navigation_entry.h"
+#include "content/public/browser/render_frame_host.h"
+#include "content/public/browser/web_contents.h"
+
+namespace tabs {
+namespace {
+constexpr char kMobileKey[] = "helium.mobile_preview";
+constexpr char kRefreshKey[] = "helium.auto_refresh_seconds";
+}  // namespace
+
+WEB_CONTENTS_USER_DATA_KEY_IMPL(PaneSettings);
+
+PaneSettings::PaneSettings(content::WebContents* contents)
+    : content::WebContentsObserver(contents),
+      content::WebContentsUserData<PaneSettings>(*contents) {}
+
+PaneSettings::~PaneSettings() {
+  Detach();
+}
+
+PaneSettings* PaneSettings::GetOrCreate(content::WebContents* contents) {
+  CreateForWebContents(contents);
+  return FromWebContents(contents);
+}
+
+void PaneSettings::PopulateExtraData(content::WebContents* contents,
+                                     std::map<std::string, std::string>* data) {
+  if (auto* settings = FromWebContents(contents)) {
+    (*data)[kMobileKey] = settings->mobile_enabled() ? "1" : "0";
+    (*data)[kRefreshKey] = base::NumberToString(settings->refresh_seconds());
+  }
+}
+
+void PaneSettings::RestoreFromExtraData(
+    content::WebContents* contents,
+    const std::map<std::string, std::string>& data) {
+  if (!data.contains(kMobileKey) && !data.contains(kRefreshKey)) {
+    return;
+  }
+  auto* settings = GetOrCreate(contents);
+  if (auto it = data.find(kMobileKey); it != data.end()) {
+    settings->SetMobileEnabled(it->second == "1");
+  }
+  int seconds = 0;
+  if (auto it = data.find(kRefreshKey);
+      it != data.end() && base::StringToInt(it->second, &seconds) &&
+      IsValidAutoRefreshInterval(seconds)) {
+    settings->SetRefreshSeconds(seconds);
+  }
+}
+
+void PaneSettings::SetMobileEnabled(bool enabled) {
+  if (mobile_enabled_ == enabled) {
+    return;
+  }
+  mobile_enabled_ = enabled;
+  if (enabled) {
+    ApplyMobileEmulation();
+  } else {
+    // Detaching also clears metrics and touch overrides in Chromium.
+    Detach();
+  }
+  Save();
+  changed_callbacks_.Notify();
+}
+
+void PaneSettings::SetRefreshSeconds(int seconds) {
+  if (!IsValidAutoRefreshInterval(seconds)) {
+    return;
+  }
+  refresh_timer_.Stop();
+  refresh_seconds_ = seconds;
+  if (seconds > 0) {
+    refresh_timer_.Start(FROM_HERE, base::Seconds(seconds), this,
+                         &PaneSettings::Refresh);
+  }
+  Save();
+  changed_callbacks_.Notify();
+}
+
+void PaneSettings::Refresh() {
+  const auto* entry = web_contents()->GetController().GetLastCommittedEntry();
+  if (web_contents()->IsLoading() || web_contents()->IsCrashed() || !entry ||
+      !entry->GetURL().SchemeIsHTTPOrHTTPS() || entry->GetHasPostData() ||
+      web_contents()->GetController().NeedsReload()) {
+    return;
+  }
+  web_contents()->GetController().Reload(content::ReloadType::NORMAL, true);
+}
+
+void PaneSettings::Save() {
+  if (!web_contents() || web_contents()->IsBeingDestroyed()) {
+    return;
+  }
+  auto* helper = sessions::SessionTabHelper::FromWebContents(web_contents());
+  if (!helper) {
+    return;
+  }
+  auto* service = SessionServiceFactory::GetForProfileIfExisting(
+      Profile::FromBrowserContext(web_contents()->GetBrowserContext()));
+  if (!service) {
+    return;
+  }
+  service->AddTabExtraData(helper->window_id(), helper->session_id(),
+                           kMobileKey, mobile_enabled_ ? "1" : "0");
+  service->AddTabExtraData(helper->window_id(), helper->session_id(),
+                           kRefreshKey, base::NumberToString(refresh_seconds_));
+}
+
+base::CallbackListSubscription PaneSettings::RegisterChanged(
+    base::RepeatingClosure callback) {
+  return changed_callbacks_.Add(std::move(callback));
+}
+
+void PaneSettings::SetPreviewScale(double scale) {
+  if (scale <= 0 || scale == preview_scale_) {
+    return;
+  }
+  preview_scale_ = scale;
+  ApplyMobileEmulation();
+}
+
+void PaneSettings::ApplyMobileEmulation() {
+  if (!mobile_enabled_ ||
+      !web_contents()->GetPrimaryMainFrame()->IsRenderFrameLive()) {
+    return;
+  }
+  if (!agent_host_) {
+    auto host = content::DevToolsAgentHost::GetOrCreateFor(web_contents());
+    // Do not compete with an existing inspector's emulation session.
+    if (host->IsAttached() || !host->AttachClient(this)) {
+      mobile_enabled_ = false;
+      Save();
+      changed_callbacks_.Notify();
+      return;
+    }
+    agent_host_ = std::move(host);
+  }
+  base::DictValue metrics;
+  metrics.Set("width", kMobilePreviewWidth);
+  metrics.Set("height", kMobilePreviewHeight);
+  metrics.Set("screenWidth", kMobilePreviewWidth);
+  metrics.Set("screenHeight", kMobilePreviewHeight);
+  metrics.Set("deviceScaleFactor", kMobilePreviewDeviceScaleFactor);
+  metrics.Set("mobile", true);
+  metrics.Set("scale", preview_scale_);
+  // Native view bounds are supplied by ContentsContainerView.
+  metrics.Set("dontSetVisibleSize", true);
+  SendCommand("Emulation.setDeviceMetricsOverride", std::move(metrics));
+  base::DictValue touch;
+  touch.Set("enabled", true);
+  touch.Set("maxTouchPoints", 5);
+  SendCommand("Emulation.setTouchEmulationEnabled", std::move(touch));
+}
+
+void PaneSettings::SendCommand(const char* method, base::DictValue params) {
+  if (!agent_host_) {
+    return;
+  }
+  base::DictValue command;
+  command.Set("id", ++next_command_id_);
+  command.Set("method", method);
+  command.Set("params", std::move(params));
+  std::string json;
+  if (base::JSONWriter::Write(command, &json)) {
+    auto host = agent_host_;
+    host->DispatchProtocolMessage(this, base::as_byte_span(json));
+  }
+}
+
+void PaneSettings::DispatchProtocolMessage(content::DevToolsAgentHost* host,
+                                           base::span<const uint8_t> message) {
+  auto response = base::JSONReader::ReadDict(
+      std::string_view(reinterpret_cast<const char*>(message.data()),
+                       message.size()),
+      base::JSON_PARSE_RFC);
+  if (response && response->contains("error")) {
+    // Failed/policy-blocked emulation must not leave a checked mobile menu
+    // item.
+    SetMobileEnabled(false);
+  }
+}
+
+void PaneSettings::Detach() {
+  if (agent_host_) {
+    auto host = std::move(agent_host_);
+    host->DetachClient(this);
+  }
+}
+
+void PaneSettings::AgentHostClosed(content::DevToolsAgentHost* host) {
+  agent_host_.reset();
+  mobile_enabled_ = false;
+  Save();
+  changed_callbacks_.Notify();
+}
+
+bool PaneSettings::MayAttachToURL(const GURL& url, bool is_webui) {
+  return !is_webui && url.SchemeIsHTTPOrHTTPS();
+}
+
+void PaneSettings::WebContentsDestroyed() {
+  refresh_timer_.Stop();
+  mobile_enabled_ = false;
+  Detach();
+}
+
+void PaneSettings::RenderFrameCreated(content::RenderFrameHost* frame) {
+  if (frame == web_contents()->GetPrimaryMainFrame()) {
+    ApplyMobileEmulation();
+  }
+}
+
+void PaneSettings::PrimaryPageChanged(content::Page& page) {
+  ApplyMobileEmulation();
+}
+}  // namespace tabs
