+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "chrome/browser/external_links_profile_mac.h"
+
+#include <os/log.h>
+
+#include "base/command_line.h"
+#include "base/files/file_path.h"
+#include "base/logging.h"
+#include "base/strings/utf_string_conversions.h"
+#include "chrome/browser/browser_process.h"
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/browser/profiles/profile_attributes_entry.h"
+#include "chrome/browser/profiles/profile_attributes_storage.h"
+#include "chrome/browser/profiles/profile_manager.h"
+#include "components/prefs/pref_registry_simple.h"
+#include "components/prefs/pref_service.h"
+
+namespace external_links {
+
+namespace {
+
+ProfileAttributesEntry* GetEntry(const base::FilePath& profile_path) {
+  ProfileManager* profile_manager = g_browser_process->profile_manager();
+  if (!profile_manager || profile_path.empty()) {
+    return nullptr;
+  }
+  return profile_manager->GetProfileAttributesStorage()
+      .GetProfileAttributesWithPath(profile_path);
+}
+
+}  // namespace
+
+void RegisterLocalStatePrefs(PrefRegistrySimple* registry) {
+  registry->RegisterStringPref(kProfilePref, std::string());
+}
+
+base::FilePath GetTargetProfilePath() {
+  PrefService* local_state = g_browser_process->local_state();
+  ProfileManager* profile_manager = g_browser_process->profile_manager();
+  if (!local_state || !profile_manager) {
+    return base::FilePath();
+  }
+  const std::string& name = local_state->GetString(kProfilePref);
+  if (name.empty()) {
+    return base::FilePath();
+  }
+  const base::FilePath path = profile_manager->user_data_dir().Append(
+      base::FilePath::FromUTF8Unsafe(name));
+  if (!GetEntry(path)) {
+    Log("Chosen profile \"" + name + "\" no longer exists");
+    return base::FilePath();
+  }
+  return path;
+}
+
+bool IsTargetProfile(const base::FilePath& profile_path) {
+  return !profile_path.empty() && GetTargetProfilePath() == profile_path;
+}
+
+void SetTargetProfile(const base::FilePath& profile_path, bool enabled) {
+  PrefService* local_state = g_browser_process->local_state();
+  if (!local_state || !GetEntry(profile_path)) {
+    return;
+  }
+  if (enabled) {
+    local_state->SetString(kProfilePref,
+                           profile_path.BaseName().AsUTF8Unsafe());
+    Log("Links from other apps now open in " +
+        DescribeProfilePath(profile_path));
+  } else if (IsTargetProfile(profile_path)) {
+    local_state->ClearPref(kProfilePref);
+    Log("Links from other apps now open in the last used window");
+  }
+}
+
+bool IsLoggingEnabled() {
+  return base::CommandLine::ForCurrentProcess()->HasSwitch(kLogSwitch);
+}
+
+void Log(std::string_view message) {
+  if (!IsLoggingEnabled()) {
+    return;
+  }
+  static os_log_t log = os_log_create("helium.link-routing", "routing");
+  LOG(WARNING) << "[link-routing] " << message;
+  // The unified log truncates long messages, so long ones (such as call
+  // stacks) are written in parts split at line breaks.
+  constexpr size_t kMaxPartSize = 800;
+  while (!message.empty()) {
+    size_t size = message.size();
+    if (size > kMaxPartSize) {
+      const size_t line_break = message.rfind('\n', kMaxPartSize);
+      size = line_break == std::string_view::npos || line_break == 0
+                 ? kMaxPartSize
+                 : line_break;
+    }
+    const std::string part(message.substr(0, size));
+    os_log(log, "%{public}s", part.c_str());
+    message.remove_prefix(size);
+    if (!message.empty() && message.front() == '\n') {
+      message.remove_prefix(1);
+    }
+  }
+}
+
+std::string DescribeProfile(const Profile* profile) {
+  if (!profile) {
+    return "(no profile)";
+  }
+  std::string description =
+      DescribeProfilePath(profile->GetOriginalProfile()->GetPath());
+  if (profile->IsOffTheRecord()) {
+    description += " (incognito)";
+  }
+  return description;
+}
+
+std::string DescribeProfilePath(const base::FilePath& profile_path) {
+  const std::string directory = profile_path.BaseName().AsUTF8Unsafe();
+  if (ProfileAttributesEntry* entry = GetEntry(profile_path)) {
+    return "\"" + base::UTF16ToUTF8(entry->GetLocalProfileName()) + "\" [" +
+           directory + "]";
+  }
+  return "[" + directory + "]";
+}
+
+}  // namespace external_links
