+// Describes `window` for the link routing log.
+std::string DescribeWindowForLog(NSWindow* window) {
+  if (!window) {
+    return "(none)";
+  }
+  std::string description;
+  BrowserWindowInterface* browser =
+      GlobalBrowserCollection::GetInstance()->FindBrowserWithWindow(
+          gfx::NativeWindow(window));
+  if (!browser) {
+    description = base::SysNSStringToUTF8(NSStringFromClass(window.class));
+  } else if (browser->GetType() == BrowserWindowInterface::TYPE_NORMAL) {
+    description =
+        "window of " + external_links::DescribeProfile(browser->GetProfile());
+  } else {
+    description =
+        "window of type " +
+        base::NumberToString(static_cast<int>(browser->GetType())) + " of " +
+        external_links::DescribeProfile(browser->GetProfile());
+  }
+  description += " #" + base::NumberToString(window.windowNumber);
+  const NSUInteger screen =
+      window.screen ? [NSScreen.screens indexOfObject:window.screen]
+                    : NSNotFound;
+  description += screen == NSNotFound
+                     ? ", no screen"
+                     : ", screen " + base::NumberToString(screen + 1);
+  if (!window.visible) {
+    description += ", hidden";
+  }
+  if (window.miniaturized) {
+    description += ", minimized";
+  }
+  if (!window.onActiveSpace) {
+    description += ", other Space";
+  }
+  return description;
+}
+
+// Describes the app state and the event being handled for the link routing
+// log.
+std::string DescribeAppStateForLog() {
+  std::string event_description = "none";
+  if (NSEvent* event = NSApp.currentEvent) {
+    switch (event.type) {
+      case NSEventTypeLeftMouseDown:
+        event_description = "left click";
+        break;
+      case NSEventTypeRightMouseDown:
+        event_description = "right click";
+        break;
+      case NSEventTypeOtherMouseDown:
+        event_description = "other click";
+        break;
+      case NSEventTypeKeyDown:
+        event_description = "key press";
+        break;
+      case NSEventTypeScrollWheel:
+        event_description = "scroll";
+        break;
+      case NSEventTypeAppKitDefined:
+        event_description = "AppKit event";
+        break;
+      default:
+        event_description = "event type " +
+                            base::NumberToString(static_cast<int>(event.type));
+        break;
+    }
+    if (event.windowNumber > 0) {
+      event_description +=
+          " in window #" + base::NumberToString(event.windowNumber);
+    }
+  }
+  return std::string("app ") + (NSApp.active ? "active" : "inactive") +
+         "; main window: " + DescribeWindowForLog(NSApp.mainWindow) +
+         "; key window: " + DescribeWindowForLog(NSApp.keyWindow) +
+         "; current event: " + event_description;
+}
+
+std::string CallStackForLog() {
+  NSArray<NSString*>* symbols = NSThread.callStackSymbols;
+  std::string stack;
+  for (NSUInteger i = 1; i < std::min<NSUInteger>(symbols.count, 24); ++i) {
+    stack += "\n  " + base::SysNSStringToUTF8(symbols[i]);
+  }
+  return stack;
+}
+
+// Names the app that sent the Apple event being handled.
+std::string SenderOfCurrentAppleEventForLog() {
+  NSAppleEventDescriptor* event =
+      NSAppleEventManager.sharedAppleEventManager.currentAppleEvent;
+  NSAppleEventDescriptor* pid =
+      [event attributeDescriptorForKeyword:keySenderPIDAttr];
+  if (!pid) {
+    return "an unknown app";
+  }
+  NSRunningApplication* app = [NSRunningApplication
+      runningApplicationWithProcessIdentifier:pid.int32Value];
+  return app.localizedName
+             ? base::SysNSStringToUTF8(app.localizedName)
+             : "process " + base::NumberToString(pid.int32Value);
+}
 
