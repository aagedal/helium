+
+#ifndef CHROME_BROWSER_EXTERNAL_LINKS_PROFILE_MAC_H_
+#define CHROME_BROWSER_EXTERNAL_LINKS_PROFILE_MAC_H_
+
+#include <string>
+#include <string_view>
+
+namespace base {
+class FilePath;
+}
+
+class PrefRegistrySimple;
+class Profile;
+
+// Links opened from other apps normally go to the profile of the most recently
+// focused window. This lets the user pick one profile for them instead.
+namespace external_links {
+
+// Local state pref with the directory name of the chosen profile. Empty means
+// links open in the profile of the most recently focused window.
+inline constexpr char kProfilePref[] = "helium.external_links.profile";
+
+// Command line switch, set from chrome://flags, that logs how links from other
+// apps are routed.
+inline constexpr char kLogSwitch[] = "log-link-routing";
+
+void RegisterLocalStatePrefs(PrefRegistrySimple* registry);
+
+// Returns the chosen profile, or an empty path when none is chosen or the
+// chosen profile no longer exists.
+base::FilePath GetTargetProfilePath();
+
+bool IsTargetProfile(const base::FilePath& profile_path);
+
+// Makes `profile_path` the chosen profile. Disabling only clears the choice if
+// `profile_path` is the chosen profile.
+void SetTargetProfile(const base::FilePath& profile_path, bool enabled);
+
+bool IsLoggingEnabled();
+
+// Writes `message` to the unified system log and the Chromium log when logging
+// is enabled.
+void Log(std::string_view message);
+
+std::string DescribeProfile(const Profile* profile);
+std::string DescribeProfilePath(const base::FilePath& profile_path);
+
+}  // namespace external_links
+
+#endif  // CHROME_BROWSER_EXTERNAL_LINKS_PROFILE_MAC_H_
